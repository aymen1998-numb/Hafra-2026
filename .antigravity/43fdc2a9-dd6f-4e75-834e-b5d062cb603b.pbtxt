        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "function updateBadges() {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
