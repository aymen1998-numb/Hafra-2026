        }
        lines {
          text: "  dashboard:{ title:\'\331\204\331\210\330\255\330\251 \330\247\331\204\331\202\331\212\330\247\330\257\330\251\', sub:\'\331\206\330\270\330\261\330\251 \330\271\330\247\331\205\330\251\' },"
