        }
        lines {
          text: "  const rows = [[\'\330\247\331\204\331\205\330\271\330\261\331\201\',\'\330\247\331\204\330\252\330\247\330\261\331\212\330\256\',\'\330\247\331\204\331\206\331\210\330\271\',\'\330\247\331\204\331\205\331\210\331\202\330\271\',\'\330\247\331\204\330\252\331\202\331\212\331\212\331\205\',\'\330\247\331\204\330\255\330\247\331\204\330\251\',\'\330\247\331\204\330\243\330\265\331\210\330\247\330\252\',\'\331\205\330\261\331\201\331\210\330\266\',\'\331\205\330\244\330\261\330\264\331\201\',\'\330\247\331\204\331\210\330\265\331\201\',\'\330\261\330\247\330\250\330\267 \330\247\331\204\330\265\331\210\330\261\330\251\',\'\330\256\330\267 \330\247\331\204\330\271\330\261\330\266\',\'\330\256\330\267 \330\247\331\204\330\267\331\210\331\204\']];"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  allReports.forEach(r => {"
