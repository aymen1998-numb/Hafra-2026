    replacement_chunks {
      target_content: "  let photo_url = null;\n  if (photoFile) {\n    try {\n      const prog = document.getElementById(\'upload-progress\');\n      const ext = (photoFile.name.split(\'.\').pop() || \'jpg\').toLowerCase().replace(/[^a-z]/g,\'\');\n      const safe_ext = [\'jpg\',\'jpeg\',\'png\',\'webp\'].includes(ext) ? ext : \'jpg\';\n      const fname = `${Date.now()}_${crypto.randomUUID()}.${safe_ext}`;\n      prog.style.width = \'40%\';\n      const fileRef = ref(storage, \'road-photos/\' + fname);\n      await uploadBytes(fileRef, photoFile);\n      prog.style.width = \'80%\';\n      photo_url = await getDownloadURL(fileRef);\n      prog.style.width = \'100%\';\n    } catch (e) {\n       console.warn(\'[hafra] Upload failed:\', e);\n    }\n  }\n\n  const rawComment = document.getElementById(\'comment\').value;\n  const payload = {\n    lat:       parseFloat(pendingLat.toFixed(6)),\n    lng:       parseFloat(pendingLng.toFixed(6)),\n    score:     selStars,\n    category:  selCategory,\n    comment:   sanitiseComment(rawComment),\n    photo_url,\n    submitter_email: currentUserEmail || null,\n    wilaya:    pendingLocationName || nearestWilaya(pendingLat, pendingLng),\n    votes:     0,\n    status: \'active\',\n    createdAt: serverTimestamp()\n  };\n\n  try {\n    const docRef = await addDoc(collection(db, \'reports\'), payload);\n    const data = { ...payload, id: docRef.id, createdAt: new Date() };\n    RateLimiter.record(); \n    if (!reports.some(x => x.id === data.id)) {\n      reports.unshift(data);\n    }"
      replacement_content: "  let photo_url = null;\n  if (photoFile) {\n    try {\n      const prog = document.getElementById(\'upload-progress\');\n      const ext = (photoFile.name.split(\'.\').pop() || \'jpg\').toLowerCase().replace(/[^a-z]/g,\'\');\n      const safe_ext = [\'jpg\',\'jpeg\',\'png\',\'webp\'].includes(ext) ? ext : \'jpg\';\n      const fname = `${Date.now()}_${crypto.randomUUID()}.${safe_ext}`;\n      prog.style.width = \'40%\';\n      \n      const { error: uploadError } = await supabase.storage.from(\'photos\').upload(fname, photoFile);\n      if (uploadError) throw uploadError;\n      \n      prog.style.width = \'80%\';\n      const { data: publicUrlData } = supabase.storage.from(\'photos\').getPublicUrl(fname);\n      photo_url = publicUrlData.publicUrl;\n      prog.style.width = \'100%\';\n    } catch (e) {\n       console.warn(\'[hafra] Upload failed:\', e);\n    }\n  }\n\n  const rawComment = document.getElementById(\'comment\').value;\n  const payload = {\n    lat:       parseFloat(pendingLat.toFixed(6)),\n    lng:       parseFloat(pendingLng.toFixed(6)),\n    score:     selStars,\n    category:  selCategory,\n    comment:   sanitiseComment(rawComment),\n    photo_url,\n    submitter_email: currentUserEmail || null,\n    wilaya:    pendingLocationName || nearestWilaya(pendingLat, pendingLng),\n    votes:     0,\n    status: \'active\',\n  };\n\n  try {\n    const { data: insertedData, error } = await supabase.from(\'reports\').insert(payload).select().single();\n    if (error) throw error;\n    \n    const data = { ...insertedData, createdAt: insertedData.created_at };\n    RateLimiter.record(); \n    if (!reports.some(x => x.id === data.id)) {\n      reports.unshift(data);\n    }"
