        }
        lines {
          text: "function esc(str) {"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "  if (str == null) return \"\";"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "  return String(str)"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    .replace(/&/g, \"&amp;\")"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
