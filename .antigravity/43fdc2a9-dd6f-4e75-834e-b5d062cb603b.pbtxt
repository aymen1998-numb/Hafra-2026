        }
        lines {
          text: "      topBox.innerHTML = `<div style=\"color:var(--dim); font-size:13px;\">\331\204\330\247 \330\252\331\210\330\254\330\257 \330\250\331\212\330\247\331\206\330\247\330\252</div>`;"
