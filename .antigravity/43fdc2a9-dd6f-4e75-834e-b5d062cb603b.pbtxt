          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const c = CATS[data.category] || CATS.pothole;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    showToast(`Signalement envoy\303\251 \342\200\224 ${c.ico} ${data.wilaya}`);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  } catch (err) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
