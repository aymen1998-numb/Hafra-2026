        lines {
          text: "    await updateDoc(doc(db, \'reports\', editingReport.id), { flagged: newFlagged });"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    await addDoc(collection(db, \'audit_log\'), { action: newFlagged ? \'flag\' : \'unflag\', admin: currentAdmin?.username, report_id: editingReport.id, createdAt: serverTimestamp() });"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
