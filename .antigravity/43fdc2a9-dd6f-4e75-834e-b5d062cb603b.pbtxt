    replacement_chunks {
      target_content: "function recalculateStats() {\n  let s = {\n    total: allReports.length,\n    active: 0, critical: 0, fixed: 0, with_photo: 0,\n    total_votes: 0, flagged: 0, today: 0, this_week: 0, avg_score: 0\n  };\n  let sumScore = 0;\n  const now = new Date();\n  for (const r of allReports) {\n    if (!r.archived && r.status === \'active\') s.active++;\n    if (r.score === 1) s.critical++;\n    if (r.status === \'fixed\') s.fixed++;\n    if (r.photo_url) s.with_photo++;\n    s.total_votes += (r.votes || 0);\n    if (r.flagged) s.flagged++;\n    sumScore += (r.score || 3);\n    const d = r.createdAt?.toDate?.() || new Date(r.createdAt);\n    if (d) {\n       if (now - d < 86400000) s.today++;\n       if (now - d < 7*86400000) s.this_week++;\n    }\n  }\n  s.avg_score = allReports.length ? (sumScore / allReports.length).toFixed(1) : \'\342\200\224\';\n  \n  const sg = document.getElementById(\'stat-grid\');\n  if (sg) {\n    sg.innerHTML = `\n      <div class=\"stat-card\">\n        <div class=\"stat-val\">${s.total}</div>\n        <div class=\"stat-label\">\330\245\330\254\331\205\330\247\331\204\331\212 \330\247\331\204\330\264\331\203\330\247\331\210\331\211</div>\n      </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-val\" style=\"color:#FF5722\">${s.active}</div>\n        <div class=\"stat-label\">\331\202\331\212\330\257 \330\247\331\204\331\205\330\271\330\247\331\204\330\254\330\251 (\331\206\330\264\330\267)</div>\n      </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-val\" style=\"color:#d32f2f\">${s.critical}</div>\n        <div class=\"stat-label\">\330\255\330\247\331\204\330\251 \330\255\330\261\330\254\330\251 (\331\206\330\254\331\205\330\251 \331\210\330\247\330\255\330\257\330\251)</div>\n      </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-val\" style=\"color:#4CAF50\">${s.fixed}</div>\n        <div class=\"stat-label\">\330\252\331\205 \330\247\331\204\330\255\331\204</div>\n      </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-val\" style=\"color:#9C27B0\">${s.flagged}</div>\n        <div class=\"stat-label\">\330\245\330\250\331\204\330\247\330\272 \331\205\330\262\331\212\331\201</div>\n      </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-val\" style=\"color:#FF9800\">${s.avg_score} <span style=\"font-size:16px\">\342\230\205</span></div>\n        <div class=\"stat-label\">\331\205\330\252\331\210\330\263\330\267 \330\247\331\204\330\252\331\202\331\212\331\212\331\205</div>\n      </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-val\">${s.today}</div>\n        <div class=\"stat-label\">\330\254\330\257\331\212\330\257 \330\247\331\204\331\212\331\210\331\205</div>\n      </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-val\">${s.with_photo}</div>\n        <div class=\"stat-label\">\331\205\330\271 \330\265\331\210\330\261\330\251 \331\205\330\261\331\201\331\202\330\251</div>\n      </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-val\" style=\"color:#FFC107\">${s.total_votes}</div>\n        <div class=\"stat-label\">\330\245\330\254\331\205\330\247\331\204\331\212 \330\247\331\204\330\252\331\210\330\253\331\212\331\202\330\247\330\252</div>\n      </div>\n    `;\n  }\n  \n  renderDetailedCharts();\n  setTimeout(() => initMap(allReports), 100);\n}\n\nfunction renderDetailedCharts() {\n  const n = allReports.length;\n  if (!n) return;\n\n  // 1. Categories\n  const catCounts = {};\n  allReports.forEach(r => {\n    let c = r.category || \'pothole\';\n    catCounts[c] = (catCounts[c] || 0) + 1;\n  });\n  const catsBox = document.getElementById(\'chart-categories\');\n  if (catsBox) {\n    catsBox.innerHTML = Object.entries(catCounts).sort((a,b)=>b[1]-a[1]).map(([c, count]) => {\n      const pc = Math.round((count/n)*100);\n      return `\n        <div class=\"chart-row\">\n          <div class=\"chart-lbl\">${getCatNameAr(c)}</div>\n          <div class=\"chart-bar-bg\"><div class=\"chart-bar ${c}\" style=\"width:${pc}%\"></div></div>\n          <div class=\"chart-val\">${count}</div>\n        </div>\n      `;\n    }).join(\'\');\n  }\n\n  // 2. Statuses\n  const stCounts = {};\n  allReports.forEach(r => {\n    let s = r.status || \'active\';\n    stCounts[s] = (stCounts[s] || 0) + 1;\n  });\n  const stBox = document.getElementById(\'chart-status\');\n  if (stBox) {\n    stBox.innerHTML = Object.entries(stCounts).sort((a,b)=>b[1]-a[1]).map(([s, count]) => {\n      const pc = Math.round((count/n)*100);\n      return `\n        <div class=\"chart-row\">\n          <div class=\"chart-lbl\">${getStatusAr(s)}</div>\n          <div class=\"chart-bar-bg\"><div class=\"chart-bar ${s}\" style=\"width:${pc}%\"></div></div>\n          <div class=\"chart-val\">${count}</div>\n        </div>\n      `;\n    }).join(\'\');\n  }\n\n  // 3. Top Reporters\n  const repCounts = {};\n  allReports.forEach(r => {\n    if (r.submitter_email) {\n      repCounts[r.submitter_email] = (repCounts[r.submitter_email] || 0) + 1;\n    }\n  });\n  const topBox = document.getElementById(\'chart-top-reporters\');\n  if (topBox) {\n    const top5 = Object.entries(repCounts).sort((a,b)=>b[1]-a[1]).slice(0,5);\n    topBox.innerHTML = top5.map(([e, c], idx) => {\n      return `\n        <div class=\"chart-row\" style=\"margin-bottom:8px;\">\n          <div style=\"width:24px; color:var(--dim)\">#${idx+1}</div>\n          <div style=\"flex:1; overflow:hidden; text-overflow:ellipsis\" title=\"${esc(e)}\">${esc(e)}</div>\n          <div style=\"font-weight:700\">${c} <span style=\"font-size:11px;color:var(--dim);font-weight:400\">\330\252\331\202\330\247\330\261\331\212\330\261</span></div>\n        </div>\n      `;\n    }).join(\'\');\n    if (!top5.length) topBox.innerHTML = \'<div style=\"color:var(--dim);text-align:center;padding:10px 0\">\331\204\330\247 \330\252\331\210\330\254\330\257 \330\250\331\212\330\247\331\206\330\247\330\252</div>\';\n  }\n\n  // 4. Time series (Last 7 days)\n  const tsBox = document.getElementById(\'chart-timeseries\');\n  if (tsBox) {\n    const today = new Date();\n    today.setHours(0,0,0,0);\n    const days = {};\n    for (let i=6; i>=0; i--) {\n       const d = new Date(today);\n       d.setDate(d.getDate() - i);\n       days[d.toLocaleDateString(\'fr-DZ\')] = 0;\n    }\n    allReports.forEach(r => {\n      const d = r.createdAt?.toDate?.() || new Date(r.createdAt);\n      if (d) {\n         const key = d.toLocaleDateString(\'fr-DZ\');\n         if (days[key] !== undefined) days[key]++;\n      }\n    });\n\n    const maxDay = Math.max(1, ...Object.values(days));\n    tsBox.innerHTML = `<div style=\"display:flex; height:120px; align-items:flex-end; gap:4px\">` + \n      Object.entries(days).map(([dStr, val]) => {\n        const height = Math.round((val/maxDay)*100);\n        return `<div style=\"flex:1; background:var(--pri); border-radius:4px 4px 0 0; position:relative; min-height:4px; height:${height}%;\" title=\"${dStr} : ${val}\">\n           <div style=\"position:absolute; top:-20px; left:0; width:100%; text-align:center; font-size:10px; color:var(--dim)\">${val>0?val:\'\'}</div>\n        </div>`;\n      }).join(\'\') + `</div>`;\n  }\n}"
      replacement_content: "function recalculateStats(reports) {\n  let s = {\n    total: reports.length,\n    active: 0, critical: 0, fixed: 0, with_photo: 0,\n    total_votes: 0, flagged: 0, today: 0, this_week: 0, avg_score: 0\n  };\n  let sumScore = 0;\n  const now = new Date();\n  for (const r of reports) {\n    if (!r.archived && r.status === \'active\') s.active++;\n    if (r.score === 1) s.critical++;\n    if (r.status === \'fixed\') s.fixed++;\n    if (r.photo_url) s.with_photo++;\n    s.total_votes += (r.votes || 0);\n    if (r.flagged) s.flagged++;\n    sumScore += (r.score || 3);\n    const d = r.createdAt?.toDate?.() || new Date(r.createdAt);\n    if (d) {\n       if (now - d < 86400000) s.today++;\n       if (now - d < 7*86400000) s.this_week++;\n    }\n  }\n  s.avg_score = reports.length ? (sumScore / reports.length).toFixed(1) : \'\342\200\224\';\n  \n  const sg = document.getElementById(\'stat-grid\');\n  if (sg) {\n    sg.innerHTML = `\n      <div class=\"stat-card\">\n        <div class=\"stat-val\">${s.total}</div>\n        <div class=\"stat-label\">\330\245\330\254\331\205\330\247\331\204\331\212 \330\247\331\204\330\264\331\203\330\247\331\210\331\211</div>\n      </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-val\" style=\"color:#FF5722\">${s.active}</div>\n        <div class=\"stat-label\">\331\202\331\212\330\257 \330\247\331\204\331\205\330\271\330\247\331\204\330\254\330\251 (\331\206\330\264\330\267)</div>\n      </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-val\" style=\"color:#d32f2f\">${s.critical}</div>\n        <div class=\"stat-label\">\330\255\330\247\331\204\330\251 \330\255\330\261\330\254\330\251 (\331\206\330\254\331\205\330\251 \331\210\330\247\330\255\330\257\330\251)</div>\n      </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-val\" style=\"color:#4CAF50\">${s.fixed}</div>\n        <div class=\"stat-label\">\330\252\331\205 \330\247\331\204\330\255\331\204</div>\n      </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-val\" style=\"color:#9C27B0\">${s.flagged}</div>\n        <div class=\"stat-label\">\330\245\330\250\331\204\330\247\330\272 \331\205\330\262\331\212\331\201</div>\n      </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-val\" style=\"color:#FF9800\">${s.avg_score} <span style=\"font-size:16px\">\342\230\205</span></div>\n        <div class=\"stat-label\">\331\205\330\252\331\210\330\263\330\267 \330\247\331\204\330\252\331\202\331\212\331\212\331\205</div>\n      </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-val\">${s.today}</div>\n        <div class=\"stat-label\">\330\254\330\257\331\212\330\257 \330\247\331\204\331\212\331\210\331\205</div>\n      </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-val\">${s.with_photo}</div>\n        <div class=\"stat-label\">\331\205\330\271 \330\265\331\210\330\261\330\251 \331\205\330\261\331\201\331\202\330\251</div>\n      </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-val\" style=\"color:#FFC107\">${s.total_votes}</div>\n        <div class=\"stat-label\">\330\245\330\254\331\205\330\247\331\204\331\212 \330\247\331\204\330\252\331\210\330\253\331\212\331\202\330\247\330\252</div>\n      </div>\n    `;\n  }\n  \n  renderDetailedCharts(reports);\n  initMap(reports);\n}\n\nfunction renderDetailedCharts(reports) {\n  const n = reports.length;\n  if (!n) return;\n\n  // 1. Categories\n  const catCounts = {};\n  reports.forEach(r => {\n    let c = r.category || \'pothole\';\n    catCounts[c] = (catCounts[c] || 0) + 1;\n  });\n  const catsBox = document.getElementById(\'chart-categories\');\n  if (catsBox) {\n    catsBox.innerHTML = Object.entries(catCounts).sort((a,b)=>b[1]-a[1]).map(([c, count]) => {\n      const pc = Math.round((count/n)*100);\n      return `\n        <div class=\"chart-row\">\n          <div class=\"chart-lbl\">${getCatNameAr(c)}</div>\n          <div class=\"chart-bar-bg\"><div class=\"chart-bar ${c}\" style=\"width:${pc}%\"></div></div>\n          <div class=\"chart-val\">${count}</div>\n        </div>\n      `;\n    }).join(\'\');\n  }\n\n  // 2. Statuses\n  const stCounts = {};\n  reports.forEach(r => {\n    let s = r.status || \'active\';\n    stCounts[s] = (stCounts[s] || 0) + 1;\n  });\n  const stBox = document.getElementById(\'chart-status\');\n  if (stBox) {\n    stBox.innerHTML = Object.entries(stCounts).sort((a,b)=>b[1]-a[1]).map(([s, count]) => {\n      const pc = Math.round((count/n)*100);\n      return `\n        <div class=\"chart-row\">\n          <div class=\"chart-lbl\">${getStatusAr(s)}</div>\n          <div class=\"chart-bar-bg\"><div class=\"chart-bar ${s}\" style=\"width:${pc}%\"></div></div>\n          <div class=\"chart-val\">${count}</div>\n        </div>\n      `;\n    }).join(\'\');\n  }\n\n  // 3. Top Reporters\n  const repCounts = {};\n  reports.forEach(r => {\n    if (r.submitter_email) {\n      repCounts[r.submitter_email] = (repCounts[r.submitter_email] || 0) + 1;\n    }\n  });\n  const topBox = document.getElementById(\'chart-top-reporters\');\n  if (topBox) {\n    const top5 = Object.entries(repCounts).sort((a,b)=>b[1]-a[1]).slice(0,5);\n    topBox.innerHTML = top5.map(([e, c], idx) => {\n      return `\n        <div class=\"chart-row\" style=\"margin-bottom:8px;\">\n          <div style=\"width:24px; color:var(--dim)\">#${idx+1}</div>\n          <div style=\"flex:1; overflow:hidden; text-overflow:ellipsis\" title=\"${esc(e)}\">${esc(e)}</div>\n          <div style=\"font-weight:700\">${c} <span style=\"font-size:11px;color:var(--dim);font-weight:400\">\330\252\331\202\330\247\330\261\331\212\330\261</span></div>\n        </div>\n      `;\n    }).join(\'\');\n    if (!top5.length) topBox.innerHTML = \'<div style=\"color:var(--dim);text-align:center;padding:10px 0\">\331\204\330\247 \330\252\331\210\330\254\330\257 \330\250\331\212\330\247\331\206\330\247\330\252</div>\';\n  }\n\n  // 4. Time series (Last 7 days)\n  const tsBox = document.getElementById(\'chart-timeseries\');\n  if (tsBox) {\n    const today = new Date();\n    today.setHours(0,0,0,0);\n    const days = {};\n    for (let i=6; i>=0; i--) {\n       const d = new Date(today);\n       d.setDate(d.getDate() - i);\n       days[d.toLocaleDateString(\'fr-DZ\')] = 0;\n    }\n    reports.forEach(r => {\n      const d = r.createdAt?.toDate?.() || new Date(r.createdAt);\n      if (d) {\n         const key = d.toLocaleDateString(\'fr-DZ\');\n         if (days[key] !== undefined) days[key]++;\n      }\n    });\n\n    const maxDay = Math.max(1, ...Object.values(days));\n    tsBox.innerHTML = `<div style=\"display:flex; height:120px; align-items:flex-end; gap:4px\">` + \n      Object.entries(days).map(([dStr, val]) => {\n        const height = Math.round((val/maxDay)*100);\n        return `<div style=\"flex:1; background:var(--pri); border-radius:4px 4px 0 0; position:relative; min-height:4px; height:${height}%;\" title=\"${dStr} : ${val}\">\n           <div style=\"position:absolute; top:-20px; left:0; width:100%; text-align:center; font-size:10px; color:var(--dim)\">${val>0?val:\'\'}</div>\n        </div>`;\n      }).join(\'\') + `</div>`;\n  }\n}"
