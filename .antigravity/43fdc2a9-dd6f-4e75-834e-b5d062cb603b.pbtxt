        }
        lines {
          text: "window.cycleStatus = async function cycleStatus(id, btn) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const { data: { user } } = await supabase.auth.getUser();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  if (!user) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
