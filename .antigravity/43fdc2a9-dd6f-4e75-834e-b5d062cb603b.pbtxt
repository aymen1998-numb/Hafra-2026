        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  // Show our custom banner first"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  showNotifBanner();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
