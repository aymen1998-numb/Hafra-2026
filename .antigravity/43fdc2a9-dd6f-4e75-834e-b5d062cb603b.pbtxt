        }
        lines {
          text: "  if (!editingReport) return;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  confirm_({"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
