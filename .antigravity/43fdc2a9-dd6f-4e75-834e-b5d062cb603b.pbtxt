          text: "  document.getElementById(\'lightbox-img\').src = safe;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  document.getElementById(\'lightbox\')?.classList.add(\'open\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
