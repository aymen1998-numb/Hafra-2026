          text: "    {id:\'d8\',lat:36.753,lng:4.053,score:2,category:\'lighting\',comment:\'Aucun \303\251clairage public sur 2km, tr\303\250s dangereux la nuit\',createdAt:new Date(now-129600000).toISOString(),wilaya:\'Tizi Ouzou\',votes:21,status:\'active\',photo_url:null},"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    {id:\'d9\',lat:34.850,lng:5.728,score:1,category:\'pothole\',comment:\'Impraticable apr\303\250s les inondations de novembre\',createdAt:new Date(now-10800000).toISOString(),wilaya:\'Biskra\',votes:39,status:\'active\',photo_url:null},"
