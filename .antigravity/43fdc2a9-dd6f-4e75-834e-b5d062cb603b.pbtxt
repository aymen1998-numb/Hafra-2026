          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    await addDoc(collection(db, \'audit_log\'), { action:\'edit\', admin: currentAdmin?.username, report_id: editingReport.id, payload: updates, createdAt: serverTimestamp() });"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
