        }
        lines {
          text: "    photoWrap.innerHTML = `<img class=\"ep-photo\" src=\"${esc(photo)}\" alt=\"photo\" onclick=\"window.openLightbox(\'${esc(photo)}\')\" onerror=\"this.style.display=\'none\'\"/>`;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  } else {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
