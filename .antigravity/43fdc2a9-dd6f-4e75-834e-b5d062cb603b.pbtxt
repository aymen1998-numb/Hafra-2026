        }
        lines {
          text: "  if (!confirm(\'\331\207\331\204 \330\243\331\206\330\252 \331\205\330\252\330\243\331\203\330\257 \331\205\331\206 \330\255\330\260\331\201 \331\207\330\260\330\247 \330\247\331\204\331\205\330\264\330\261\331\201\330\237 (\' + emailId + \')\')) return;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
