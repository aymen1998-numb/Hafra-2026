          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        <div class=\"gallery-cat\" style=\"color:${c.col}\">${c.ico} ${esc(c.fr)}</div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        <div class=\"gallery-meta\">${esc(r.wilaya||\'\342\200\224\')} \302\267 ${\'\342\255\220\'.repeat(r.score)}</div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
