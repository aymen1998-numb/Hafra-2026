        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const rawComment = document.getElementById(\'comment\').value;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const payload = {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
