        }
        lines {
          text: "window.closeLightbox = function closeLightbox() { document.getElementById(\'lightbox\')?.classList.remove(\'open\'); }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "document.addEventListener(\'keydown\', e => { if (e.key === \'Escape\') { window.closeLightbox(); window.closeEditor(); window.closeConfirm(); } });"
