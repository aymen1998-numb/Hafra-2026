        }
        lines {
          text: "function nearestWilaya(lat, lng) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  let best = \'Alg\303\251rie\', minD = Infinity;"
