        }
        lines {
          text: "const ATTEMPT_KEY = \'hf_admin_tries\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "const MAX_ATTEMPTS = 5;"
