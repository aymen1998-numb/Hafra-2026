        }
        lines {
          text: "            <div style=\"width:100%; max-width:24px; height:${h}%; min-height:4px; background:var(--acc); border-radius:4px 4px 0 0;\"></div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            <div style=\"font-size:9px; color:var(--dim);\">${dateStr.substring(0,5)}</div>"
