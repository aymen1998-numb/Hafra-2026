    replacement_chunks {
      target_content: "function populateWilayaFilter() {\n  const wilayas = [...new Set(allReports.map(r => r.wilaya).filter(Boolean))].sort();\n  const sel = document.getElementById(\'f-wilaya\');\n  if (!sel) return;\n  sel.innerHTML = \'<option value=\"\">\331\203\331\204 \330\247\331\204\330\250\331\204\330\257\331\212\330\247\330\252</option>\' +\n    wilayas.map(w => `<option value=\"${esc(w)}\">${esc(w)}</option>`).join(\'\');\n}\n\nwindow.applyFilters = function applyFilters() {\n  const searchEl = document.getElementById(\'f-search\');\n  const wilayaEl = document.getElementById(\'f-wilaya\');\n  const catEl    = document.getElementById(\'f-cat\');\n  const statusEl = document.getElementById(\'f-status\');\n  const scoreEl  = document.getElementById(\'f-score\');\n\n  const search = searchEl ? searchEl.value.toLowerCase() : \'\';\n  const wilaya = wilayaEl ? wilayaEl.value : \'\';\n  const cat    = catEl    ? catEl.value    : \'\';\n  const status = statusEl ? statusEl.value : \'\';\n  const score  = scoreEl  ? parseInt(scoreEl.value, 10) : 0;\n\n  filteredReports = allReports.filter(r => {\n    if (r.archived) return false;\n    if (wilaya && r.wilaya !== wilaya) return false;\n    if (cat && r.category !== cat) return false;\n    if (status && r.status !== status) return false;\n    if (score && r.score !== score) return false;"
      replacement_content: "function populateWilayaFilter() {\n  const allStates = new Set();\n  const allPlaces = new Set();\n\n  allReports.forEach(r => {\n    if (!r.wilaya) return;\n    const parts = r.wilaya.split(\', \');\n    if (parts.length === 2) {\n      allPlaces.add(parts[0]);\n      allStates.add(parts[1]);\n    } else {\n      allStates.add(parts[0]);\n    }\n  });\n\n  const selW = document.getElementById(\'f-wilaya\');\n  if (selW) {\n    selW.innerHTML = \'<option value=\"\">\331\203\331\204 \330\247\331\204\331\210\331\204\330\247\331\212\330\247\330\252</option>\' + \n      [...allStates].sort().map(w => `<option value=\"${esc(w)}\">${esc(w)}</option>`).join(\'\');\n  }\n\n  const selC = document.getElementById(\'f-commune\');\n  if (selC) {\n    selC.innerHTML = \'<option value=\"\">\331\203\331\204 \330\247\331\204\330\250\331\204\330\257\331\212\330\247\330\252</option>\' + \n      [...allPlaces].sort().map(c => `<option value=\"${esc(c)}\">${esc(c)}</option>`).join(\'\');\n  }\n}\n\nwindow.applyFilters = function applyFilters() {\n  const searchEl = document.getElementById(\'f-search\');\n  const wilayaEl = document.getElementById(\'f-wilaya\');\n  const communeEl= document.getElementById(\'f-commune\');\n  const catEl    = document.getElementById(\'f-cat\');\n  const statusEl = document.getElementById(\'f-status\');\n  const scoreEl  = document.getElementById(\'f-score\');\n\n  const search = searchEl ? searchEl.value.toLowerCase() : \'\';\n  const wilaya = wilayaEl ? wilayaEl.value : \'\';\n  const commune = communeEl ? communeEl.value : \'\';\n  const cat    = catEl    ? catEl.value    : \'\';\n  const status = statusEl ? statusEl.value : \'\';\n  const score  = scoreEl  ? parseInt(scoreEl.value, 10) : 0;\n\n  filteredReports = allReports.filter(r => {\n    if (r.archived) return false;\n\n    const parts = (r.wilaya || \'\').split(\', \');\n    const rPlace = parts.length === 2 ? parts[0] : \'\';\n    const rState = parts.length === 2 ? parts[1] : parts[0];\n\n    if (wilaya && rState !== wilaya) return false;\n    if (commune && rPlace !== commune) return false;\n    if (cat && r.category !== cat) return false;\n    if (status && r.status !== status) return false;\n    if (score && r.score !== score) return false;"
    }
    instruction: "Update filter logic for wilaya and commune"
  }
}
