          text: "  if (diff < 3600000) return `\331\205\331\206\330\260 ${Math.max(1, Math.floor(diff/60000))} \330\257\331\202\330\247\330\246\331\202`;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  if (diff < 86400000) return `\331\205\331\206\330\260 ${Math.floor(diff/3600000)} \330\263\330\247\330\271\330\251`;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
