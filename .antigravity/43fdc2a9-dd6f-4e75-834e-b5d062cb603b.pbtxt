          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  if (!tbody) return;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  if (!page.length) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    tbody.innerHTML = `<tr><td colspan=\"9\"><div class=\"empty-state\"><div class=\"empty-ico\">\360\237\223\213</div><div class=\"empty-txt\">\331\204\330\247 \330\252\331\210\330\254\330\257 \330\264\331\203\330\247\331\210\331\211</div></div></td></tr>`;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  } else {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    tbody.innerHTML = page.map(r => reportRow(r, true)).join(\'\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  renderPagination();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "function reportRow(r, withCheckbox) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const photo = safePhotoUrl(r.photo_url);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const isSel = selectedIds.has(r.id);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  return `<tr class=\"${r.archived?\'archived-row\':\'\'} ${isSel?\'selected\':\'\'}\" data-id=\"${esc(r.id)}\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ${withCheckbox ? `<td><input type=\"checkbox\" class=\"cb\" ${isSel?\'checked\':\'\'} onchange=\"window.toggleSelect(\'${esc(r.id)}\',this)\"/></td>` : \'\'}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    <td style=\"font-family:var(--sans);font-size:12px;color:var(--dim);font-weight:600\">${formatArDate(r.createdAt)}</td>"
