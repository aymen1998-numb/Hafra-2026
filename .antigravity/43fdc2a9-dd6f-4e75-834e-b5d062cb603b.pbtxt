          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "function renderReportsTable() {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
