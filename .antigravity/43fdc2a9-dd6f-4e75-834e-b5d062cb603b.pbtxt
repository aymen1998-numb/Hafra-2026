        lines {
          text: "  if (!email || !email.includes(\'@\')) return toast(\"\330\247\331\204\330\261\330\254\330\247\330\241 \330\245\330\257\330\256\330\247\331\204 \330\250\330\261\331\212\330\257 \330\245\331\204\331\203\330\252\330\261\331\210\331\206\331\212 \330\265\330\255\331\212\330\255\", \"error\");"
