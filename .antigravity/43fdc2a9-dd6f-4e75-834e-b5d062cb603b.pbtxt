          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        localStorage.setItem(KEY, JSON.stringify({ ts: now, n: 1 }));"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
