        lines {
          text: "    if (va < vb) return sortAsc ? -1 : 1;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (va > vb) return sortAsc ? 1 : -1;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    return 0;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
