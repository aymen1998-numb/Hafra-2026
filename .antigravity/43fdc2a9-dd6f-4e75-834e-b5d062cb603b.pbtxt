          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  document.getElementById(\'ep-notes\').value   = r.admin_notes || \'\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  document.getElementById(\'ep-coords\').textContent = `${(r.lat||0).toFixed(5)}, ${(r.lng||0).toFixed(5)}`;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const flagBtn = document.getElementById(\'ep-flag-btn\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
