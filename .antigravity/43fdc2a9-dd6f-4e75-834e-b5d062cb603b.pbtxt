          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  try {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    await supabase.from(\'reports\').update(updates).eq(\'id\', editingReport.id);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    await supabase.from(\'audit_log\').insert({ action:\'edit\', admin: currentAdmin?.username, report_id: editingReport.id, payload: updates });"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const idx = allReports.findIndex(r => r.id === editingReport.id);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
