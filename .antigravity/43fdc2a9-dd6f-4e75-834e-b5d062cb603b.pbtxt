        lines {
          text: "    .replace(/</g, \"&lt;\")"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    .replace(/>/g, \"&gt;\")"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    .replace(/\"/g, \"&quot;\")"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    .replace(/\'/g, \"&#039;\");"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "/** Create a text node \342\200\224 zero XSS risk. Use for all user-supplied content. */"
