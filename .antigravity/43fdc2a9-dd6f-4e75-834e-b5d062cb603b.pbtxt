      replacement_content: "const fs = require(\'fs\');\nconst path = require(\'path\');\n\nconst p = path.resolve(__dirname, \'src/app.js\');\nlet code = fs.readFileSync(p, \'utf8\');\n\n// 1. Remove Supabase import\ncode = code.replace(`import { supabase } from \"./supabase.js\";`, `// MVP Version - Supabase removed`);\n\n// 2. Auth changes\nconst authTarget = `supabase.auth.onAuthStateChange((event, session) => {\n  if (session && session.user && session.user.email) {\n    currentUserEmail = session.user.email;\n    document.getElementById(\"auth-state\").textContent = currentUserEmail;\n    document.getElementById(\"auth-state\").style.color = \"var(--txt)\";\n    document.getElementById(\"auth-btn\").textContent = \"D\303\251connexion\";\n  } else {\n    currentUserEmail = null;\n    document.getElementById(\"auth-state\").textContent = \"Non connect\303\251\";\n    document.getElementById(\"auth-state\").style.color = \"#ef4444\";\n    document.getElementById(\"auth-btn\").textContent = \"Connexion Google\";\n  }\n});\n\nwindow.toggleAuth = async function () {\n  if (currentUserEmail) {\n    await supabase.auth.signOut();\n  } else {\n    try {\n      await supabase.auth.signInWithOAuth({\n        provider: \"google\",\n        options: {\n          redirectTo: window.location.origin,\n        },\n      });\n    } catch (e) {\n      console.warn(\"Connexion \303\251chou\303\251e\", e);\n      showToast(\"Connexion annul\303\251e ou \303\251chou\303\251e\");\n    }\n  }\n};`;\n\nconst authRepl = `// MVP Auth\nlet currentUserEmail = localStorage.getItem(\"hafra_email\") || null;\nif (currentUserEmail) {\n  document.getElementById(\"auth-state\").textContent = currentUserEmail;\n  document.getElementById(\"auth-state\").style.color = \"var(--txt)\";\n  document.getElementById(\"auth-btn\").textContent = \"D\303\251connexion\";\n} else {\n  document.getElementById(\"auth-state\").textContent = \"Non connect\303\251\";\n  document.getElementById(\"auth-state\").style.color = \"#ef4444\";\n  document.getElementById(\"auth-btn\").textContent = \"Connexion MVP\";\n}\n\nwindow.toggleAuth = async function () {\n  if (currentUserEmail) {\n    localStorage.removeItem(\"hafra_email\");\n    currentUserEmail = null;\n    document.getElementById(\"auth-state\").textContent = \"Non connect\303\251\";\n    document.getElementById(\"auth-state\").style.color = \"#ef4444\";\n    document.getElementById(\"auth-btn\").textContent = \"Connexion MVP\";\n  } else {\n    const email = prompt(\"Mode MVP : Entrez votre email :\");\n    if (email && email.includes(\"@\")) {\n      localStorage.setItem(\"hafra_email\", email);\n      currentUserEmail = email;\n      document.getElementById(\"auth-state\").textContent = currentUserEmail;\n      document.getElementById(\"auth-state\").style.color = \"var(--txt)\";\n      document.getElementById(\"auth-btn\").textContent = \"D\303\251connexion\";\n    }\n  }\n};`;\n\ncode = code.replace(authTarget, authRepl);\n\n// 3. Load Reports\nconst loadTarget = `async function loadReports() {\n  try {\n    const { data, error } = await supabase\n      .from(\"reports\")\n      .select(\"*\")\n      .order(\"created_at\", { ascending: false })\n      .limit(500);\n    if (error) throw error;\n    reports = data || [];\n    renderMap();\n    updateStats();\n    renderPanel();\n  } catch (e) {\n    console.error(\"Error loading reports\", e);\n  }\n}`;\n\nconst loadRepl = `async function loadReports() {\n  try {\n    const data = JSON.parse(localStorage.getItem(\'hafra_reports\') || \'[]\');\n    reports = data;\n  } catch (e) {\n    reports = [];\n  }\n  renderMap();\n  updateStats();\n  renderPanel();\n}`;\n\ncode = code.replace(loadTarget, loadRepl);\n\n// 4. Realtime target\nconst realtimeTarget = `function subscribeRealtime() {\n  supabase\n    .channel(\"public:reports\")\n    .on(\n      \"postgres_changes\",\n      { event: \"*\", schema: \"public\", table: \"reports\" },\n      (payload) => {\n        if (payload.eventType === \"INSERT\") {\n          if (!reports.some((r) => r.id === payload.new.id)) {\n            reports.unshift(payload.new);\n            renderMap();\n            updateStats();\n            renderPanel();\n          }\n        }\n        if (payload.eventType === \"UPDATE\") {\n          const idx = reports.findIndex((r) => r.id === payload.new.id);\n          if (idx !== -1) {\n            reports[idx] = { ...reports[idx], ...payload.new };\n            renderMap();\n            updateStats();\n            renderPanel();\n          }\n        }\n        if (payload.eventType === \"DELETE\") {\n          reports = reports.filter((r) => r.id !== payload.old.id);\n          renderMap();\n          updateStats();\n          renderPanel();\n        }\n      },\n    )\n    .subscribe();\n}`;\n\nconst realtimeRepl = `function subscribeRealtime() {\n  // Mode MVP - Pas de temps r\303\251el r\303\251seau, fonctionne en local\n}`;\n\ncode = code.replace(realtimeTarget, realtimeRepl);\n\n\n// 5. Submit overrides\nconst submitRegex = /const btn = document\\.getElementById\\(\"submit-btn\"\\);[\\s\\S]*?renderPanel\\(\\);\\n\\}/m;\n\n// Just in case, let\'s extract exactly the body of submitReport:\n// Let\'s replace the whole window.submitReport block\nconst submitTarget = code.substring(code.indexOf(\'window.submitReport = async function submitReport() {\'));\n// Wait, the substring goes to the end of file? So we should slice properly\n"
    }
