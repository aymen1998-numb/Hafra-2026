        }
        lines {
          text: "  if (selW && changed) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const prevW = selW.value;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    selW.innerHTML = \'<option value=\"\">\331\203\331\204 \330\247\331\204\331\210\331\204\330\247\331\212\330\247\330\252</option>\' + [...knownStates].sort().map(w => `<option value=\"${esc(w)}\">${esc(w)}</option>`).join(\'\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    selW.value = prevW;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    updateCommunesFilter();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  } else if (!selW && changed) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    // If not ready yet"
