          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          <div style=\"width:140px; font-size:12px; color:var(--dim); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;\" title=\"${email}\">${email.split(\'@\')[0]}</div>"
