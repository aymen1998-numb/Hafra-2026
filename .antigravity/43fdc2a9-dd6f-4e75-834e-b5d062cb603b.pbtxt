        }
        lines {
          text: "window.addAdminEmail = async function() {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  if (!currentAdmin) return toast(\"Non autoris\303\251\", \"error\");"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const el = document.getElementById(\'new-admin-email\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  if (!el) return;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const email = el.value.trim().toLowerCase();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  if (!email || !email.includes(\'@\')) return toast(\"\330\247\331\204\330\261\330\254\330\247\330\241 \330\245\330\257\330\256\330\247\331\204 \330\250\330\261\331\212\330\257 \330\245\331\204\331\203\330\252\330\261\331\210\331\206\331\212 \330\265\330\255\331\212\330\255\", \"error\");"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const btn = event.currentTarget;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const oldTxt = btn.textContent;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  btn.disabled = true; btn.textContent = \'...\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  try {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    await setDoc(doc(db, \'allowed_emails\', email), { "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "       addedBy: currentAdmin.username, "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "       createdAt: serverTimestamp() "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    });"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    toast(\"\330\252\331\205\330\252 \330\245\330\266\330\247\331\201\330\251 \330\247\331\204\331\205\330\264\330\261\331\201 \330\250\331\206\330\254\330\247\330\255\", \"success\");"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    el.value = \'\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  } catch(e) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    handleFirestoreError(e, OperationType.CREATE, \'allowed_emails\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  btn.disabled = false; btn.textContent = oldTxt;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "window.removeAdminEmail = async function(emailId) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  if (!currentAdmin) return toast(\"Non autoris\303\251\", \"error\");"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  if (!confirm(\'\331\207\331\204 \330\243\331\206\330\252 \331\205\330\252\330\243\331\203\330\257 \331\205\331\206 \330\255\330\260\331\201 \331\207\330\260\330\247 \330\247\331\204\331\205\330\264\330\261\331\201\330\237 (\' + emailId + \')\')) return;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  try {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
