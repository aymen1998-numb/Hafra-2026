        lines {
          text: "  flagged:  { title:\'\331\205\330\261\331\201\331\210\330\266\330\251\', sub:\'\330\252\331\205 \330\247\331\204\330\245\330\250\331\204\330\247\330\272 \330\271\331\206\331\207\330\247 \331\203\331\205\330\262\331\212\331\201\330\251\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
