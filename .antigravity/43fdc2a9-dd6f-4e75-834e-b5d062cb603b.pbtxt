  planner_response {
    modified_response: "\331\204\331\202\330\257 \331\202\331\205\330\252 \330\250\330\245\330\265\331\204\330\247\330\255 \331\205\330\264\331\203\331\204\330\251 \330\247\331\204\330\252\330\265\331\201\331\212\330\251 \330\250\330\255\330\263\330\250 \330\247\331\204\330\250\331\204\330\257\331\212\330\251 \331\201\331\212 \331\204\331\210\330\255\330\251 \330\247\331\204\331\202\331\212\330\247\330\257\330\251\330\214 \331\210\330\252\330\243\331\203\330\257\330\252 \331\205\331\206 \330\243\331\206 \330\247\331\204\330\243\330\262\330\261\330\247\330\261 \331\205\330\253\331\204 \"Confirmer\" \330\252\330\271\331\205\331\204 \330\255\330\265\330\261\331\212\330\247\331\213 \331\204\331\204\331\205\330\263\330\244\331\210\331\204\331\212\331\206. \n\n\330\245\331\204\331\212\331\203 \331\205\330\247 \331\202\331\205\330\252 \330\250\331\207 \330\250\330\247\331\204\330\252\331\201\330\265\331\212\331\204:\n1. **\331\204\331\210\330\255\330\251 \330\247\331\204\331\202\331\212\330\247\330\257\330\251 (Dashboard):**\n   - \330\243\330\266\331\201\330\252 \331\201\331\204\330\252\330\261 \330\247\331\204\330\250\331\204\330\257\331\212\330\247\330\252 (\330\247\331\204\330\260\331\212 \330\263\331\217\331\205\331\221\331\212 \"\331\203\331\204 \330\247\331\204\330\250\331\204\330\257\331\212\330\247\330\252\") \330\250\330\254\330\247\331\206\330\250 \331\201\331\204\330\252\330\261 \330\247\331\204\331\210\331\204\330\247\331\212\330\247\330\252 \331\201\331\212 \331\204\331\210\330\255\330\251 \330\247\331\204\331\202\331\212\330\247\330\257\330\251.\n   - \331\202\331\205\330\252 \330\250\330\261\330\250\330\267 \331\207\330\260\330\247 \330\247\331\204\331\201\331\204\330\252\330\261 \331\204\331\212\331\203\331\210\331\206 \331\205\330\263\330\244\331\210\331\204\330\247\331\213 \330\271\331\206 \330\252\330\255\330\257\331\212\330\253 \331\203\331\204\330\247 \331\205\331\206 **\330\247\331\204\330\256\330\261\331\212\330\267\330\251** \331\210 **\330\245\330\255\330\265\330\247\330\246\331\212\330\247\330\252 \330\247\331\204\330\264\331\203\330\247\331\210\331\211 \330\247\331\204\330\243\330\263\330\247\330\263\331\212\330\251 \331\210\330\247\331\204\331\205\330\256\330\267\330\267\330\247\330\252** \330\247\331\204\330\256\330\247\330\265\330\251 \330\250\331\204\331\210\330\255\330\251 \330\247\331\204\331\202\331\212\330\247\330\257\330\251 \330\257\331\212\331\206\330\247\331\205\331\212\331\203\331\212\330\247 \330\250\331\206\330\247\330\241\331\213 \330\271\331\204\331\211 \330\247\331\204\331\210\331\204\330\247\331\212\330\251 \331\210\330\247\331\204\330\250\331\204\330\257\331\212\330\251 \330\247\331\204\331\205\330\255\330\257\330\257\330\251.\n2. **\330\264\330\247\330\264\330\251 \330\247\331\204\330\264\331\203\330\247\331\210\331\211:**\n   - \331\202\331\205\330\252 \330\250\330\252\330\255\330\257\331\212\330\253 \331\205\331\206\330\267\331\202 \330\247\331\204\330\252\330\265\331\201\331\212\330\251 \330\247\331\204\330\257\330\247\330\256\331\204\331\212\330\233 \330\250\330\255\331\212\330\253 \330\243\331\206\331\207 \330\250\331\205\330\254\330\261\330\257 \330\247\330\256\330\252\331\212\330\247\330\261 \331\210\331\204\330\247\331\212\330\251\330\214 \331\212\330\252\331\205 \330\254\331\204\330\250 \330\247\331\204\330\250\331\204\330\257\331\212\330\247\330\252 \330\247\331\204\330\252\331\212 \330\252\331\205 \330\247\331\204\330\252\330\250\331\204\331\212\330\272 \331\201\331\212\331\207\330\247 \330\266\331\205\331\206 \330\252\331\204\331\203 \330\247\331\204\331\210\331\204\330\247\331\212\330\251 \331\201\331\202\330\267\330\214 \331\210\330\252\330\267\330\250\331\212\331\202\331\207\330\247 \330\250\330\257\331\202\330\251.\n3. **\330\243\330\257\331\210\330\247\330\261 \330\247\331\204\331\205\330\263\330\244\331\210\331\204\331\212\331\206 (Admins):**\n   - \330\252\331\205 \330\245\330\262\330\247\331\204\330\251 \330\262\330\261 \"\330\252\330\243\331\203\331\212\330\257\" (Confirmer) \331\205\331\206 \330\247\331\204\331\210\330\247\330\254\331\207\330\251 \330\247\331\204\330\271\330\247\331\205\330\251 \331\204\331\204\331\205\330\263\330\252\330\256\330\257\331\205\331\212\331\206 \330\247\331\204\330\271\330\247\330\257\331\212\331\212\331\206\330\214 \330\255\331\212\330\253 \331\212\330\270\331\207\330\261 \331\204\331\207\331\205 \330\247\331\204\330\242\331\206 \331\201\331\202\330\267 **\331\205\330\254\331\205\331\210\330\271 \330\247\331\204\330\252\331\210\330\253\331\212\331\202\330\247\330\252** \330\243\331\210 \330\247\331\204\331\205\331\210\330\247\331\201\331\202\330\247\330\252.\n   - \331\212\331\205\331\203\331\206 \330\247\331\204\330\242\331\206 **\331\204\331\204\331\205\330\263\330\244\331\210\331\204\331\212\331\206 \331\201\331\202\330\267 (Admins)** \330\252\331\206\331\201\331\212\330\260 \330\245\330\254\330\261\330\247\330\241\330\247\330\252 \330\247\331\204\330\252\330\243\331\203\331\212\330\257 \330\243\331\210 \330\247\331\204\330\252\330\250\331\204\331\212\330\272 \330\243\331\210 \330\252\330\272\331\212\331\212\330\261 \330\255\330\247\331\204\330\247\330\252 \330\247\331\204\330\252\331\202\330\247\330\261\331\212\330\261 \331\205\331\206 \330\257\330\247\330\256\331\204 \331\204\331\210\330\255\330\251 \330\247\331\204\330\257\330\256\331\210\331\204 \331\204\331\204\331\205\330\264\330\261\331\201\331\212\331\206.\n\n\330\247\331\204\330\242\331\206 \330\252\330\271\331\205\331\204 \330\247\331\204\331\201\331\204\330\247\330\252\330\261 \330\250\330\264\331\203\331\204 \330\265\330\255\331\212\330\255 \331\210\330\252\330\255\330\257\330\253 \330\247\331\204\330\245\330\255\330\265\330\247\330\246\331\212\330\247\330\252 \331\205\330\271\331\207\330\247! \331\207\331\204 \331\207\331\206\330\247\331\203 \330\243\331\212 \330\252\330\271\330\257\331\212\331\204 \330\242\330\256\330\261 \330\252\331\210\330\257 \330\245\330\266\330\247\331\201\330\252\331\207 \330\271\331\204\331\211 \331\204