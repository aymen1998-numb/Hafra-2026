        }
        lines {
          text: "function renderPagination() {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const total = filteredReports.length;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const pages = Math.ceil(total / PAGE_SIZE);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const el = document.getElementById(\'reports-pagination\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  if (pages <= 1) { el.innerHTML = \'\'; return; }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const start = (currentPage-1)*PAGE_SIZE+1;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const end   = Math.min(currentPage*PAGE_SIZE, total);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  el.innerHTML = `"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    <span>${start}\342\200\223${end} sur ${total}</span>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    <div class=\"pg-btns\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      <button class=\"pg-btn\" onclick=\"window.goPage(${currentPage-1})\" ${currentPage===1?\'disabled\':\'\'}>\342\206\220</button>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      ${Array.from({length:Math.min(pages,7)},(_,i)=>{"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        const p = i+1;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        return `<button class=\"pg-btn ${p===currentPage?\'active\':\'\'}\" onclick=\"window.goPage(${p})\">${p}</button>`;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      }).join(\'\')}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      <button class=\"pg-btn\" onclick=\"window.goPage(${currentPage+1})\" ${currentPage===pages?\'disabled\':\'\'}>\342\206\222</button>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  `;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "window.goPage = function goPage(p) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
