        }
        lines {
          text: "  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const optionsHTML = \'<option value=\"\">\331\203\331\204 \330\247\331\204\331\210\331\204\330\247\331\212\330\247\330\252</option>\' + [...knownStates].sort().map(w => `<option value=\"${esc(w)}\">${esc(w)}</option>`).join(\'\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (selW && changed) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const prevW = selW.value;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    selW.innerHTML = \'<option value=\"\">\331\203\331\204 \330\247\331\204\331\210\331\204\330\247\331\212\330\247\330\252</option>\' + [...knownStates].sort().map(w => `<option value=\"${esc(w)}\">${esc(w)}</option>`).join(\'\');"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    selW.innerHTML = optionsHTML;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    selW.value = prevW;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    updateCommunesFilter();"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "  } else if (!selW && changed) {"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    // If not ready yet"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "  }"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "  }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (dashW && changed) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const prevDW = dashW.value;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    dashW.innerHTML = optionsHTML;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    dashW.value = prevDW;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (changed) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    updateCommunesFilter();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    updateDashCommunesFilter();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "window.updateDashCommunesFilter = function updateDashCommunesFilter() {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const dashW = document.getElementById(\'f-dash-wilaya\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const dashC = document.getElementById(\'f-dash-commune\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (!dashC) return;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const currentW = dashW ? dashW.value : \'\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const prevC = dashC.value;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  let allowedPlaces = new Set();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (currentW && stateToPlaces[currentW]) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    allowedPlaces = stateToPlaces[currentW];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  } else if (!currentW) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    allowedPlaces = knownPlaces;"
