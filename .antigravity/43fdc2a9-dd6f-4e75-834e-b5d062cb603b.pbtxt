  file_change {
    absolute_path_uri: "file:///src/app.js"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "// \342\224\200\342\224\200 LOAD REPORTS \342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\nasync function loadReports() {\n  try {\n    const q = query(collection(db, \'reports\'), orderBy(\'createdAt\', \'desc\'), limit(500));\n    const qs = await getDocs(q);\n    reports = qs.docs.map(d => ({ id: d.id, ...d.data() }));\n    renderMap(); updateStats(); renderPanel();\n  } catch (e) {\n    console.warn(\'[hafra] Load error:\', e);\n    if (!reports.length) reports = getDemoData();\n    renderMap(); updateStats(); renderPanel();\n    setConnPill(false, \'Mode hors-ligne\');\n  } finally {\n    // Always hide the loader \342\200\224 no matter what throws above\n    hideLoader();\n  }\n}\n\nfunction hideLoader() {\n  const el = document.getElementById(\'app-loading\');\n  el?.classList.add(\'hidden\');\n  if (el) setTimeout(() => el?.remove(), 500);\n}\n\n// \342\224\200\342\224\200 REALTIME \342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\nfunction subscribeRealtime() {\n  const q = query(collection(db, \'reports\'), orderBy(\'createdAt\', \'desc\'), limit(50));\n  onSnapshot(q, (snapshot) => {\n    snapshot.docChanges().forEach((change) => {\n      if (change.type === \'added\') {\n        const r = { id: change.doc.id, ...change.doc.data() };\n        // Check if we already have it\n        if (!reports.some(x => x.id === r.id)) {\n          reports.unshift(r);\n          renderMap(); updateStats(); renderPanel();\n        }\n      } else if (change.type === \'modified\') {\n        const r = { id: change.doc.id, ...change.doc.data() };\n        const idx = reports.findIndex(x => x.id === r.id);\n        if (idx > -1) {\n          reports[idx] = r;\n          renderMap(); updateStats(); renderPanel();\n        }\n      }\n    });\n  }, (error) => {\n    handleFirestoreError(error, OperationType.GET, \'reports\');\n  });\n}"
      replacement_content: "// \342\224\200\342\224\200 LOAD REPORTS \342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\nasync function loadReports() {\n  try {\n    const { data, error } = await supabase.from(\'reports\').select(\'*\').order(\'created_at\', { ascending: false }).limit(500);\n    if (error) throw error;\n    reports = (data || []).map(d => ({ ...d, createdAt: d.created_at }));\n    renderMap(); updateStats(); renderPanel();\n  } catch (e) {\n    console.warn(\'[hafra] Load error:\', e);\n    if (!reports.length) reports = window.getDemoData ? window.getDemoData() : [];\n    renderMap(); updateStats(); renderPanel();\n    setConnPill(false, \'Mode hors-ligne\');\n  } finally {\n    // Always hide the loader \342\200\224 no matter what throws above\n    hideLoader();\n  }\n}\n\nfunction hideLoader() {\n  const el = document.getElementById(\'app-loading\');\n  el?.classList.add(\'hidden\');\n  if (el) setTimeout(() => el?.remove(), 500);\n}\n\n// \342\224\200\342\224\200 REALTIME \342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\nfunction subscribeRealtime() {\n  supabase.channel(\'public:reports\')\n    .on(\'postgres_changes\', { event: \'*\', schema: \'public\', table: \'reports\' }, payload => {\n      if (payload.eventType === \'INSERT\') {\n        const r = { ...payload.new, createdAt: payload.new.created_at };\n        if (!reports.some(x => x.id === r.id)) {\n          reports.unshift(r);\n          renderMap(); updateStats(); renderPanel();\n        }\n      } else if (payload.eventType === \'UPDATE\') {\n        const r = { ...payload.new, createdAt: payload.new.created_at };\n        const idx = reports.findIndex(x => x.id === r.id);\n        if (idx > -1) {\n          reports[idx] = Object.assign(reports[idx], r);\n          renderMap(); updateStats(); renderPanel();\n        }\n      }\n    })\n    .subscribe((status) => {\n      if (status === \'SUBSCRIBED\') {\n        console.log(\'Realtime subscribed\');\n      }\n    });\n}"
    }
