          text: "      properties:{"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        id:r.id, score:r.score,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
