        }
        lines {
          text: "    input.value = \'\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    return;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
