          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if(tbody) tbody.innerHTML = `<tr><td colspan=\"6\"><div class=\"empty-state\"><div class=\"empty-ico\">\360\237\223\213</div><div class=\"empty-txt\">\331\204\330\247 \330\252\331\210\330\254\330\257 \330\264\331\203\330\247\331\210\331\211</div></div></td></tr>`;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
