    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "  const grid = document.getElementById(\'stat-grid\');\n  if(grid) {\n    grid.innerHTML = cards.map(c => `\n      <div class=\"stat-card\">\n        <div class=\"stat-card-left ${c.iconClass}\">${c.icon}</div>\n        <div class=\"stat-card-right\">\n          <div class=\"stat-label\">${esc(c.label)}</div>\n          <div class=\"stat-value\">${esc(String(c.value))}</div>\n          <div class=\"stat-delta\">${esc(c.delta)}</div>\n        </div>\n      </div>\n    `).join(\'\');\n  }\n  \n  renderDetailedCharts();\n  setTimeout(() => initMap(allReports), 100);\n}\n\nfunction renderDetailedCharts() {\n  const n = allReports.length;\n  if (!n) return;\n\n  // 1. Categories\n  const catCounts = {};\n  allReports.forEach(r => {\n    let c = r.category || \'pothole\';\n    catCounts[c] = (catCounts[c] || 0) + 1;\n  });\n  const catsBox = document.getElementById(\'chart-categories\');\n  if (catsBox) {\n    catsBox.innerHTML = Object.entries(catCounts).sort((a,b)=>b[1]-a[1]).map(([cat, freq]) => {\n      const c = CATS[cat] || CATS.pothole;\n      const pct = (freq / n) * 100;\n      return `<div style=\"display:flex; align-items:center; gap:12px;\">\n        <div style=\"width:100px; font-size:13px; color:var(--dim); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;\">${c.ico} ${c.fr}</div>\n        <div style=\"flex:1; height:8px; background:var(--bg); border-radius:4px; overflow:hidden;\">\n           <div style=\"height:100%; width:${pct}%; background:${c.col};\"></div>\n        </div>\n        <div style=\"width:30px; text-align:left; font-family:var(--sans); font-size:12px; font-weight:600;\">${freq}</div>\n      </div>`;\n    }).join(\'\');\n  }\n\n  // 2. Statuses\n  const stCounts = {};\n  allReports.forEach(r => {\n    let s = r.status || \'active\';\n    stCounts[s] = (stCounts[s] || 0) + 1;\n  });\n  const stBox = document.getElementById(\'chart-status\');\n  if (stBox) {\n    stBox.innerHTML = Object.entries(stCounts).sort((a,b)=>b[1]-a[1]).map(([status, freq]) => {\n      const st = STATUS_CFG[status] || STATUS_CFG.active;\n      const pct = (freq / n) * 100;\n      return `<div style=\"display:flex; align-items:center; gap:12px;\">\n        <div style=\"width:100px; font-size:13px; color:var(--dim);\">${st.dot} ${st.fr}</div>\n        <div style=\"flex:1; height:8px; background:var(--bg); border-radius:4px; overflow:hidden;\">\n           <div style=\"height:100%; width:${pct}%; background:${st.col};\"></div>\n        </div>\n        <div style=\"width:30px; text-align:left; font-family:var(--sans); font-size:12px; font-weight:600;\">${freq}</div>\n      </div>`;\n    }).join(\'\');\n  }\n\n  // 3. Top Reporters\n  const repCounts = {};\n  allReports.forEach(r => {\n    if (r.submitter_email) {\n      repCounts[r.submitter_email] = (repCounts[r.submitter_email] || 0) + 1;\n    }\n  });\n  const topBox = document.getElementById(\'chart-top-reporters\');\n  if (topBox) {\n    const sortedReps = Object.entries(repCounts).sort((a,b)=>b[1]-a[1]).slice(0, 5);\n    if (!sortedReps.length) {\n      topBox.innerHTML = `<div style=\"color:var(--dim); font-size:13px;\">\331\204\330\247 \330\252\331\210\330\254\330\257 \330\250\331\212\330\247\331\206\330\247\330\252</div>`;"
      replacement_content: "  const grid = document.getElementById(\'stat-grid\');\n  if(grid) {\n    grid.innerHTML = cards.map(c => `\n      <div class=\"stat-card\">\n        <div class=\"stat-card-left ${c.iconClass}\">${c.icon}</div>\n        <div class=\"stat-card-right\">\n          <div class=\"stat-label\">${esc(c.label)}</div>\n          <div class=\"stat-value\">${esc(String(c.value))}</div>\n          <div class=\"stat-delta\">${esc(c.delta)}</div>\n        </div>\n      </div>\n    `).join(\'\');\n  }\n}\n\nfunction renderDetailedCharts(reports) {\n  const n = reports.length;\n  if (!n) return;\n\n  // 1. Categories\n  const catCounts = {};\n  reports.forEach(r => {\n    let c = r.category || \'pothole\';\n    catCounts[c] = (catCounts[c] || 0) + 1;\n  });\n  const catsBox = document.getElementById(\'chart-categories\');\n  if (catsBox) {\n    catsBox.innerHTML = Object.entries(catCounts).sort((a,b)=>b[1]-a[1]).map(([cat, freq]) => {\n      const c = CATS[cat] || CATS.pothole;\n      const pct = (freq / n) * 100;\n      return `<div style=\"display:flex; align-items:center; gap:12px;\">\n        <div style=\"width:100px; font-size:13px; color:var(--dim); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;\">${c.ico} ${c.fr}</div>\n        <div style=\"flex:1; height:8px; background:var(--bg); border-radius:4px; overflow:hidden;\">\n           <div style=\"height:100%; width:${pct}%; background:${c.col};\"></div>\n        </div>\n        <div style=\"width:30px; text-align:left; font-family:var(--sans); font-size:12px; font-weight:600;\">${freq}</div>\n      </div>`;\n    }).join(\'\');\n  }\n\n  // 2. Statuses\n  const stCounts = {};\n  reports.forEach(r => {\n    let s = r.status || \'active\';\n    stCounts[s] = (stCounts[s] || 0) + 1;\n  });\n  const stBox = document.getElementById(\'chart-status\');\n  if (stBox) {\n    stBox.innerHTML = Object.entries(stCounts).sort((a,b)=>b[1]-a[1]).map(([status, freq]) => {\n      const st = STATUS_CFG[status] || STATUS_CFG.active;\n      const pct = (freq / n) * 100;\n      return `<div style=\"display:flex; align-items:center; gap:12px;\">\n        <div style=\"width:100px; font-size:13px; color:var(--dim);\">${st.dot} ${st.fr}</div>\n        <div style=\"flex:1; height:8px; background:var(--bg); border-radius:4px; overflow:hidden;\">\n           <div style=\"height:100%; width:${pct}%; background:${st.col};\"></div>\n        </div>\n        <div style=\"width:30px; text-align:left; font-family:var(--sans); font-size:12px; font-weight:600;\">${freq}</div>\n      </div>`;\n    }).join(\'\');\n  }\n\n  // 3. Top Reporters\n  const repCounts = {};\n  reports.forEach(r => {\n    if (r.submitter_email) {\n      repCounts[r.submitter_email] = (repCounts[r.submitter_email] || 0) + 1;\n    }\n  });\n  const topBox = document.getElementById(\'chart-top-reporters\');\n  if (topBox) {\n    const sortedReps = Object.entries(repCounts).sort((a,b)=>b[1]-a[1]).slice(0, 5);\n    if (!sortedReps.length) {\n      topBox.innerHTML = `<div style=\"color:var(--dim); font-size:13px;\">\331\204\330\247 \330\252\331\210\330\254\330\257 \330\250\331\212\330\247\331\206\330\247\330\252</div>`;"
    }
