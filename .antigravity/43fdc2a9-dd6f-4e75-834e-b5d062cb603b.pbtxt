      target_content: "async function loadReports() {\n  try {\n    const { data, error } = await supabase\n      .from(\"reports\")\n      .select(\"*\")\n      .order(\"created_at\", { ascending: false })\n      .limit(500);\n    if (error) throw error;\n    reports = (data || []).map((d) => ({ ...d, createdAt: d.created_at }));\n    renderMap();\n    updateStats();\n    renderPanel();\n  } catch (e) {\n    console.warn(\"[hafra] Load error:\", e);\n    if (!reports.length)\n      reports = window.getDemoData ? window.getDemoData() : [];\n    renderMap();\n    updateStats();\n    renderPanel();\n  }\n}"
      replacement_content: "async function loadReports() {\n  try {\n    const stored = localStorage.getItem(\'hafra_reports\');\n    if(stored) {\n      reports = JSON.parse(stored);\n    }\n    renderMap();\n    updateStats();\n    renderPanel();\n  } catch (e) {\n    console.warn(\"[hafra] Load error:\", e);\n    if (!reports.length)\n      reports = window.getDemoData ? window.getDemoData() : [];\n    renderMap();\n    updateStats();\n    renderPanel();\n  }\n}"
    }
    replacement_chunks {
      target_content: "function subscribeRealtime() {\n  supabase\n    .channel(\"public:reports\")\n    .on(\n      \"postgres_changes\",\n      { event: \"*\", schema: \"public\", table: \"reports\" },\n      (payload) => {\n        if (payload.eventType === \"INSERT\") {\n          const data = { ...payload.new, createdAt: payload.new.created_at };\n          if (!reports.some((r) => r.id === data.id)) {\n            reports.unshift(data);\n            renderMap();\n            updateStats();\n            renderPanel();\n          }\n        }\n        if (payload.eventType === \"UPDATE\") {\n          const idx = reports.findIndex((r) => r.id === payload.new.id);\n          if (idx !== -1) {\n            reports[idx] = { ...reports[idx], ...payload.new };\n            reports[idx].createdAt = payload.new.created_at;\n            renderMap();\n            updateStats();\n            renderPanel();\n          }\n        }\n        if (payload.eventType === \"DELETE\") {\n          reports = reports.filter((r) => r.id !== payload.old.id);\n          renderMap();\n          updateStats();\n          renderPanel();\n        }\n      },\n    )\n    .subscribe();\n}"
      replacement_content: "function subscribeRealtime() {\n  // Mode MVP - Pas de temps r\303\251el r\303\251seau, fonctionne en local\n}"
    }
