          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "async function loadReports() {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  try {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const { data, error } = await supabase.from(\'reports\').select(\'*\').order(\'created_at\', { ascending: false }).limit(500);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
