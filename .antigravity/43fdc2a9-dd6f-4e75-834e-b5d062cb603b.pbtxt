        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "window.resetFilters = function resetFilters() {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  [\'f-search\',\'f-wilaya\',\'f-cat\',\'f-status\',\'f-score\'].forEach(id => {"
