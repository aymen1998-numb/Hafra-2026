        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "function renderRecentTable() {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
