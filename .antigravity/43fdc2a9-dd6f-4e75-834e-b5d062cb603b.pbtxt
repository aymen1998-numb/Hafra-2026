        lines {
          text: "  renderReportsTable();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const cEl = document.getElementById(\'reports-count\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  if(cEl) cEl.textContent = `${filteredReports.length} \331\206\330\252\331\212\330\254\330\251`;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "window.sortBy = function sortBy(field) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  if (sortField === field) sortAsc = !sortAsc;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
