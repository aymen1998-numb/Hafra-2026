  file_change {
    absolute_path_uri: "file:///src/admin.js"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "function subscribeRealtime() {\n  if (unsubReports) unsubReports();\n  if (unsubAudit) unsubAudit();\n  if (unsubAdmins) unsubAdmins();\n\n  const qReports = query(collection(db, \'reports\'), orderBy(\'createdAt\', \'desc\'), limit(2000));\n  unsubReports = onSnapshot(qReports, (snap) => {\n    allReports = snap.docs.map(d => ({id: d.id, ...d.data()}));\n    \n    // Inject mock data if empty for preview purposes\n    if (allReports.length === 0) {\n      allReports = [\n        { id: \'mock1\', score: 1, wilaya: \'Alger\', category: \'pothole\', status: \'active\', votes: 12, createdAt: new Date() },\n        { id: \'mock2\', score: 3, wilaya: \'Oran\', category: \'cracks\', status: \'active\', votes: 3, createdAt: new Date(Date.now() - 86400000) },\n        { id: \'mock3\', score: 2, wilaya: \'Constantine\', category: \'other\', status: \'active\', votes: 5, flagged: true, createdAt: new Date(Date.now() - 2*86400000) },\n        { id: \'mock4\', score: 1, wilaya: \'Alger\', category: \'pothole\', status: \'fixed\', votes: 45, createdAt: new Date(Date.now() - 3*86400000) },\n      ];\n    }\n    \n    populateWilayaFilter();\n    window.applyFilters();\n    renderRecentTable();\n    renderPhotos();\n    renderFlagged();\n    renderArchived();\n    updateBadges();\n    recalculateStats();\n  }, err => {\n    toast(\'Erreur signalements: \' + err.message, \'error\');\n  });\n\n  const qAudit = query(collection(db, \'audit_log\'), orderBy(\'createdAt\', \'desc\'), limit(200));\n  unsubAudit = onSnapshot(qAudit, (snap) => {\n    allAudit = snap.docs.map(d => ({id: d.id, ...d.data()}));\n    \n    if (allAudit.length === 0) {\n      allAudit = [\n        { id: \'a1\', action: \'edit\', admin: \'Aymen\', report_id: \'mock1\', createdAt: new Date() },\n        { id: \'a2\', action: \'flag\', admin: \'Aymen\', report_id: \'mock3\', createdAt: new Date(Date.now() - 3600000) },\n        { id: \'a3\', action: \'delete\', admin: \'Aymen\', report_id: \'mock99\', createdAt: new Date(Date.now() - 86400000) },\n      ];\n    }\n    \n    renderAudit(allAudit);\n  }, err => {\n    console.warn(\"Audit error\", err);\n  });\n\n  const qAdmins = collection(db, \'allowed_emails\');\n  unsubAdmins = onSnapshot(qAdmins, (snap) => {\n    allAdmins = snap.docs.map(d => ({id: d.id, ...d.data()}));\n    renderAdmins(allAdmins);\n  }, err => {\n    console.warn(\"Admins error\", err);\n  });\n}"
      replacement_content: "async function subscribeRealtime() {\n  if (unsubReports) unsubReports.unsubscribe();\n  if (unsubAudit) unsubAudit.unsubscribe();\n  if (unsubAdmins) unsubAdmins.unsubscribe();\n\n  const fetchIteratively = async () => {\n    try {\n      const { data: repData } = await supabase.from(\'reports\').select(\'*\').order(\'created_at\', { ascending: false }).limit(2000);\n      const { data: auditData } = await supabase.from(\'audit_log\').select(\'*\').order(\'created_at\', { ascending: false }).limit(200);\n      const { data: adminData } = await supabase.from(\'allowed_emails\').select(\'*\');\n      \n      allReports = (repData || []).map(d => ({ ...d, createdAt: d.created_at }));\n      allAudit = (auditData || []).map(d => ({ ...d, createdAt: d.created_at }));\n      allAdmins = (adminData || []).map(d => ({ ...d, createdAt: d.created_at }));\n      \n      if (allReports.length === 0) {\n        allReports = [\n          { id: \'mock1\', score: 1, wilaya: \'Alger\', category: \'pothole\', status: \'active\', votes: 12, createdAt: new Date() },\n          { id: \'mock2\', score: 3, wilaya: \'Oran\', category: \'cracks\', status: \'active\', votes: 3, createdAt: new Date(Date.now() - 86400000) },\n          { id: \'mock3\', score: 2, wilaya: \'Constantine\', category: \'other\', status: \'active\', votes: 5, flagged: true, createdAt: new Date(Date.now() - 2*86400000) },\n          { id: \'mock4\', score: 1, wilaya: \'Alger\', category: \'pothole\', status: \'fixed\', votes: 45, createdAt: new Date(Date.now() - 3*86400000) },\n        ];\n      }\n      if (allAudit.length === 0) {\n        allAudit = [\n          { id: \'a1\', action: \'edit\', admin: \'Aymen\', report_id: \'mock1\', createdAt: new Date() },\n          { id: \'a2\', action: \'flag\', admin: \'Aymen\', report_id: \'mock3\', createdAt: new Date(Date.now() - 3600000) },\n          { id: \'a3\', action: \'delete\', admin: \'Aymen\', report_id: \'mock99\', createdAt: new Date(Date.now() - 86400000) },\n        ];\n      }\n      \n      populateWilayaFilter();\n      window.applyFilters();\n      renderRecentTable();\n      renderPhotos();\n      renderFlagged();\n      renderArchived();\n      updateBadges();\n      recalculateStats();\n      renderAudit(allAudit);\n      renderAdmins(allAdmins);\n    } catch (e) { console.error(\'fetch\', e); }\n  }\n  \n  await fetchIteratively();\n  \n  unsubReports = supabase.channel(\'admin:reports\').on(\'postgres_changes\', { event: \'*\', schema: \'public\', table: \'reports\' }, () => { fetchIteratively(); }).subscribe();\n  unsubAudit = supabase.channel(\'admin:audit_log\').on(\'postgres_changes\', { event: \'*\', schema: \'public\', table: \'audit_log\' }, () => { fetchIteratively(); }).subscribe();\n  unsubAdmins = supabase.channel(\'admin:allowed_emails\').on(\'postgres_changes\', { event: \'*\', schema: \'public\', table: \'allowed_emails\' }, () => { fetchIteratively(); }).subscribe();\n}"
    }
