        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  selC.innerHTML = \'<option value=\"\">\331\203\331\204 \330\247\331\204\330\250\331\204\330\257\331\212\330\247\330\252</option>\' + [...allowedPlaces].sort().map(c => `<option value=\"${esc(c)}\">${esc(c)}</option>`).join(\'\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  if (allowedPlaces.has(prevC)) {"
