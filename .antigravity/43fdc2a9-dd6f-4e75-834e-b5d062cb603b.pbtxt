        }
        lines {
          text: "    if (data && data.address) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const a = data.address;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
