    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "  renderPanel();\n  try { \n    await updateDoc(doc(db, \'reports\', id), { votes: increment(1) }); \n    await addDoc(collection(db, \'confirmations\'), { email, report_id: id, createdAt: serverTimestamp() });\n  } catch(e) { handleFirestoreError(e, OperationType.UPDATE, \'reports\'); }\n  showToast(\'Confirmation enregistr\303\251e\');\n}\n\nwindow.cycleStatus = async function cycleStatus(id, btn) {\n  if (!auth.currentUser || auth.currentUser.isAnonymous) {\n    if (confirm(\"Seuls les mod\303\251rateurs peuvent changer le statut. Voulez-vous vous connecter avec Google ?\")) {\n      try {\n        await signInWithPopup(auth, new GoogleAuthProvider());\n        if (!auth.currentUser || auth.currentUser.isAnonymous) return; // double check\n      } catch(e) {\n        if(e.code !== \'auth/popup-closed-by-user\') showToast(\"Erreur de connexion\");\n        return;\n      }\n    } else {\n      return;\n    }\n  }\n\n  const r = reports.find(x => x.id === id);\n  if (!r) return;\n  const order = [\'active\',\'reported\',\'fixed\'];\n  const nextStatus = order[(order.indexOf(r.status || \'active\') + 1) % 3];\n  \n  // Store old value in case we need to revert\n  const oldTxt = btn.textContent;\n  \n  try { \n    btn.textContent = \'...\';\n    await updateDoc(doc(db, \'reports\', id), { status: nextStatus }); \n    r.status = nextStatus;\n    const st = STATUSES[r.status];\n    btn.textContent = `${st.dot} ${st.fr}`;\n    renderPanel();\n    showToast(`Statut: ${st.fr}`);\n  } catch(e) { \n    btn.textContent = oldTxt; // revert\n    \n    // Detailed error logging\n    try {\n      handleFirestoreError(e, OperationType.UPDATE, \'reports\');\n    } catch(handledErr) {\n       let errorObj;\n       try { errorObj = JSON.parse(handledErr.message); } catch(parseErr){}\n       if (errorObj && errorObj.error && errorObj.error.includes(\"permission\")) {\n          showToast(\"\330\271\330\260\330\261\330\247\331\213\330\214 \331\212\330\254\330\250 \330\243\331\206 \330\252\331\203\331\210\331\206 \331\205\330\264\330\261\331\201\330\247\331\213 \331\204\330\252\330\272\331\212\331\212\330\261 \330\247\331\204\330\255\330\247\331\204\330\251\", true); // red toast\n       } else {\n          showToast(\"Erreur serveur\", true);\n       }\n    }\n  }\n}"
      replacement_content: "  renderPanel();\n  try { \n    await supabase.rpc(\'increment_votes\', { row_id: id });\n    await supabase.from(\'confirmations\').insert({ email, report_id: id });\n  } catch(e) { console.error(\'Upvote error\', e); }\n  showToast(\'Confirmation enregistr\303\251e\');\n}\n\nwindow.cycleStatus = async function cycleStatus(id, btn) {\n  const { data: { user } } = await supabase.auth.getUser();\n  if (!user) {\n    if (confirm(\"Seuls les mod\303\251rateurs peuvent changer le statut. Voulez-vous vous connecter avec Google ?\")) {\n      try {\n        await supabase.auth.signInWithOAuth({ provider: \'google\' });\n        return; // Page will redirect\n      } catch(e) {\n        showToast(\"Erreur de connexion\");\n        return;\n      }\n    } else {\n      return;\n    }\n  }\n\n  const r = reports.find(x => x.id === id);\n  if (!r) return;\n  const order = [\'active\',\'reported\',\'fixed\'];\n  const nextStatus = order[(order.indexOf(r.status || \'active\') + 1) % 3];\n  \n  // Store old value in case we need to revert\n  const oldTxt = btn.textContent;\n  \n  try { \n    btn.textContent = \'...\';\n    const { error } = await supabase.from(\'reports\').update({ status: nextStatus }).eq(\'id\', id);\n    if (error) throw error;\n    r.status = nextStatus;\n    const st = STATUSES[r.status];\n    btn.textContent = `${st.dot} ${st.fr}`;\n    renderPanel();\n    showToast(`Statut: ${st.fr}`);\n  } catch(e) { \n    btn.textContent = oldTxt; // revert\n    console.error(\'cycleStatus error\', e);\n    showToast(\"\330\271\330\260\330\261\330\247\331\213\330\214 \331\212\330\254\330\250 \330\243\331\206 \330\252\331\203\331\210\331\206 \331\205\330\264\330\261\331\201\330\247\331\213 \331\204\330\252\330\272\331\212\331\212\330\261 \330\247\331\204\330\255\330\247\331\204\330\251\", true); // red toast\n  }\n}"
