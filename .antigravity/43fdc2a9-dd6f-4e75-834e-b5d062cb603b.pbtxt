    instruction: "Fix populateWilayaFilter to properly handle state and prevent losing focus, and add an updateCommunes function to only update communes when needed."
    replacement_infos {
      original_chunk {
        target_content: "function populateWilayaFilter() {\n  const allStates = new Set();\n  const stateToPlaces = {};\n\n  allReports.forEach(r => {\n    if (!r.wilaya) return;\n    const parts = r.wilaya.split(\', \');\n    let state = parts[0];\n    let place = \'\';\n    \n    if (parts.length === 2) {\n      place = parts[0].trim();\n      state = parts[1].trim();\n    }\n    \n    allStates.add(state);\n    if (place) {\n      if (!stateToPlaces[state]) stateToPlaces[state] = new Set();\n      stateToPlaces[state].add(place);\n    }\n  });\n\n  const selW = document.getElementById(\'f-wilaya\');\n  const selC = document.getElementById(\'f-commune\');\n  \n  if (selW) {\n    const prevW = selW.value;\n    selW.innerHTML = \'<option value=\"\">\331\203\331\204 \330\247\331\204\331\210\331\204\330\247\331\212\330\247\330\252</option>\' + [...allStates].sort().map(w => `<option value=\"${esc(w)}\">${esc(w)}</option>`).join(\'\');\n    selW.value = prevW;\n  }\n\n  // Update commune based on selected wilaya, or show all if no wilaya selected\n  if (selC) {\n    const prevC = selC.value;\n    const currentW = selW ? selW.value : \'\';\n    let allowedPlaces = new Set();\n    \n    if (currentW && stateToPlaces[currentW]) {\n      allowedPlaces = stateToPlaces[currentW];\n    } else if (!currentW) {\n      // Show all places\n      Object.values(stateToPlaces).forEach(places => {\n        places.forEach(p => allowedPlaces.add(p));\n      });\n    }\n\n    selC.innerHTML = \'<option value=\"\">\331\203\331\204 \330\247\331\204\330\250\331\204\330\257\331\212\330\247\330\252</option>\' + [...allowedPlaces].sort().map(c => `<option value=\"${esc(c)}\">${esc(c)}</option>`).join(\'\');\n    // Restore if still valid\n    if (allowedPlaces.has(prevC)) {\n      selC.value = prevC;\n    } else {\n      selC.value = \'\';\n    }\n  }\n}\n\nwindow.applyFilters = function applyFilters() {\n  const searchEl = document.getElementById(\'f-search\');\n  const wilayaEl = document.getElementById(\'f-wilaya\');\n  const communeEl= document.getElementById(\'f-commune\');\n  const catEl    = document.getElementById(\'f-cat\');\n  const statusEl = document.getElementById(\'f-status\');\n  const scoreEl  = document.getElementById(\'f-score\');\n\n  // If applyFilters is triggered by wilayaEl change, we should refresh the commune options\n  const isWilayaTrigger = document.activeElement === wilayaEl;\n  if (isWilayaTrigger) {\n    populateWilayaFilter();\n  }\n\n  const search = searchEl ? searchEl.value.toLowerCase() : \'\';\n  const wilaya = wilayaEl ? wilayaEl.value : \'\';\n  const commune = communeEl ? communeEl.value : \'\';\n  const cat    = catEl    ? catEl.value : \'\';\n  const status = statusEl ? statusEl.value : \'\';\n  const score  = scoreEl  ? scoreEl.value : \'\';"
        replacement_content: "let knownStates = new Set();\nlet knownPlaces = new Set();\nlet stateToPlaces = {};\n\nfunction populateWilayaFilter() {\n  let changed = false;\n  \n  allReports.forEach(r => {\n    if (!r.wilaya) return;\n    const parts = r.wilaya.split(\', \');\n    let state = parts[0].trim();\n    let place = \'\';\n    \n    if (parts.length === 2) {\n      place = parts[0].trim();\n      state = parts[1].trim();\n    }\n    \n    if (!knownStates.has(state)) {\n      knownStates.add(state);\n      changed = true;\n    }\n    \n    if (place) {\n      if (!stateToPlaces[state]) stateToPlaces[state] = new Set();\n      if (!stateToPlaces[state].has(place)) {\n        stateToPlaces[state].add(place);\n        knownPlaces.add(place);\n        changed = true;\n      }\n    }\n  });\n\n  const selW = document.getElementById(\'f-wilaya\');\n  if (selW && changed) {\n    const prevW = selW.value;\n    selW.innerHTML = \'<option value=\"\">\331\203\331\204 \330\247\331\204\331\210\331\204\330\247\331\212\330\247\330\252</option>\' + [...knownStates].sort().map(w => `<option value=\"${esc(w)}\">${esc(w)}</option>`).join(\'\');\n    selW.value = prevW;\n    updateCommunesFilter();\n  } else if (!selW && changed) {\n    // If not ready yet\n  }\n}\n\nwindow.updateCommunesFilter = function updateCommunesFilter() {\n  const selW = document.getElementById(\'f-wilaya\');\n  const selC = document.getElementById(\'f-commune\');\n  if (!selC) return;\n  \n  const currentW = selW ? selW.value : \'\';\n  const prevC = selC.value;\n  let allowedPlaces = new Set();\n  \n  if (currentW && stateToPlaces[currentW]) {\n    allowedPlaces = stateToPlaces[currentW];\n  } else if (!currentW) {\n    // Show all places\n    allowedPlaces = knownPlaces;\n  }\n\n  selC.innerHTML = \'<option value=\"\">\331\203\331\204 \330\247\331\204\330\250\331\204\330\257\331\212\330\247\330\252</option>\' + [...allowedPlaces].sort().map(c => `<option value=\"${esc(c)}\">${esc(c)}</option>`).join(\'\');\n  \n  if (allowedPlaces.has(prevC)) {\n    selC.value = prevC;\n  } else {\n    selC.value = \'\';\n  }\n}\n\nwindow.applyFilters = function applyFilters() {\n  const searchEl = document.getElementById(\'f-search\');\n  const wilayaEl = document.getElementById(\'f-wilaya\');\n  const communeEl= document.getElementById(\'f-commune\');\n  const catEl    = document.getElementById(\'f-cat\');\n  const statusEl = document.getElementById(\'f-status\');\n  const scoreEl  = document.getElementById(\'f-score\');\n\n  const isWilayaTrigger = document.activeElement === wilayaEl;\n  if (isWilayaTrigger) {\n    updateCommunesFilter();\n  }\n\n  const search = searchEl ? searchEl.value.toLowerCase() : \'\';\n  const wilaya = wilayaEl ? wilayaEl.value : \'\';\n  const commune = communeEl ? communeEl.value : \'\';\n  const cat    = catEl    ? catEl.value : \'\';\n  const status = statusEl ? statusEl.value : \'\';\n  const score  = scoreEl  ? scoreEl.value : \'\';"
      }
