          text: "    <span>${start}\342\200\223${end} sur ${total}</span>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    <div class=\"pg-btns\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      <button class=\"pg-btn\" onclick=\"window.goPage(${currentPage-1})\" ${currentPage===1?\'disabled\':\'\'}>\342\206\220</button>"
