          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      <button class=\"ar-btn-outline\" style=\"padding:4px 12px;font-size:12px;color:var(--red);border-color:var(--bdr)\" onclick=\"window.quickDelete(\'${esc(r.id)}\')\">\330\255\330\260\331\201</button>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    </div></td>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
