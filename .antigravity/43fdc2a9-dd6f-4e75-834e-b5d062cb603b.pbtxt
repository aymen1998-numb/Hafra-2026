        }
        lines {
          text: "  const today = new Date();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  for (let i=6; i>=0; i--) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "     const d = new Date(today);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "     d.setDate(d.getDate() - i);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "     days[d.toLocaleDateString(\'fr-DZ\')] = 0;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
