        lines {
          text: "    "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const idx = allReports.findIndex(r => r.id === editingReport.id);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (idx > -1) allReports[idx] = { ...allReports[idx], ...updates };"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    window.applyFilters(); renderRecentTable(); renderPhotos();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
