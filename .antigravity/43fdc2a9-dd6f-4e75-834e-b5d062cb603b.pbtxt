ZE);\n  page.forEach(r => {\n    if (masterCb.checked) selectedIds.add(r.id); else selectedIds.delete(r.id);\n  });\n  renderReportsTable(); updateBulkBar();\n}\nwindow.clearSelection = function clearSelection() {\n  selectedIds.clear();\n  renderReportsTable();\n  document.getElementById(\'select-all\').checked = false;\n  updateBulkBar();\n}\nfunction updateBulkBar() {\n  const bar = document.getElementById(\'bulk-bar\');\n  const n = selectedIds.size;\n  document.getElementById(\'bulk-count\').textContent = `${n} s\303\251lectionn\303\251${n>1?\'s\':\'\'}`;\n  bar.classList.toggle(\'show\', n > 0);\n}\n\nwindow.bulkAction = async function bulkAction(action) {\n  if (!selectedIds.size) return;\n  const ids = [...selectedIds];\n  const label = {\n    fix:\'marqu\303\251s comme r\303\251par\303\251s\', flag:\'marqu\303\251s comme faux\',\n    archive:\'archiv\303\251s\', delete:\'supprim\303\251s\',\n  }[action];\n  confirm_({\n    icon: action===\'delete\'?\'\360\237\227\221\357\270\217\':\'\342\232\240\357\270\217\',\n    title:`${action===\'delete\'?\'Supprimer\':\'Modifier\'} ${ids.length} signalement${ids.length>1?\'s\':\'\'}?`,\n    body:`Ces signalements seront ${label}.${action===\'delete\'?\' Cette action est irr\303\251versible.\':\'\'}`,\n    ok: action===\'delete\'?\'Supprimer\':action===\'archive\'?\'Archiver\':\'Confirmer\',\n    async onOk() {\n      const updates = { fix:{status:\'fixed\'}, flag:{flagged:true,status:\'flagged\'}, archive:{archived:true} }[action];\n      for (const id of ids) {\n        if (action === \'delete\') {\n          const r = allReports.find(x => x.id === id);\n          const photoUrl = safePhotoUrl(r?.photo_url);\n          if (photoUrl) {\n            const path = photoUrl.split(\'/road-photos/\').pop();\n            if (path) await deleteObject(ref(storage, \'road-photos/\' + path));\n          }\n          await deleteDoc(doc(db, \'reports\', id));\n          await addDoc(collection(db, \'audit_log\'), { action:\'delete\', admin: currentAdmin?.username, report_id:id, createdAt: serverTimestamp() });\n        } else {\n          await updateDoc(doc(db, \'reports\', id), updates);\n          await addDoc(collection(db, \'audit_log\'), { action:action, admin: currentAdmin?.username, report_id:id, payload:updates, createdAt: serverTimestamp() });\n        }\n      }\n      if (action === \'delete\') allReports = allReports.filter(r => !ids.includes(r.id));\n      else allReports = allReports.map(r => ids.includes(r.id) ? {...r,...updates} : r);\n      window.clearSelection();\n      window.applyFilters(); renderRecentTable(); renderPhotos(); renderFlagged(); renderArchived(); updateBadges();\n      toast(`${ids.length} signalement${ids.length>1?\'s\':\'\'} ${label}`, \'success\');\n    }\n  });\n}"
      replacement_content: "    async onOk() {\n      try {\n        const photoUrl = safePhotoUrl(r?.photo_url);\n        if (photoUrl) {\n          const path = photoUrl.split(\'/photos/\').pop();\n          if (path) await supabase.storage.from(\'photos\').remove([path]);\n        }\n        await supabase.from(\'reports\').delete().eq(\'id\', id);\n        await supabase.from(\'audit_log\').insert({ action:\'delete\', admin: currentAdmin?.username, report_id: id });\n        allReports = allReports.filter(r => r.id !== id);\n        window.applyFilters(); renderRecentTable(); renderPhotos(); renderFlagged(); renderArchived(); updateBadges();\n        toast(\'Supprim\303\251\', \'success\');\n      } catch (err) {\n        toast(\'Erreur: \' + err.message, \'error\');\n      }\n    }\n  });\n}\n\n// \342\224\200\342\224\200 BULK SELECTION \342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\nwindow.toggleSelect = function toggleSelect(id, cb) {\n  if (cb.checked) selectedIds.add(id); else selectedIds.delete(id);\n  const tr = cb.closest(\'tr\');\n  if (tr) tr.classList.toggle(\'selected\', cb.checked);\n  updateBulkBar();\n}\nwindow.toggleSelectAll = function toggleSelectAll(masterCb) {\n  const start = (currentPage-1)*PAGE_SIZE;\n  const page  = filteredReports.slice(start, start+PAGE_SIZE);\n  page.forEach(r => {\n    if (masterCb.checked) selectedIds.add(r.id); else selectedIds.delete(r.id);\n  });\n  renderReportsTable(); updateBulkBar();\n}\nwindow.clearSelection = function clearSelection() {\n  selectedIds.clear();\n  renderReportsTable();\n  document.getElementById(\'select-all\').checked = false;\n  updateBulkBar();\n}\nfunction updateBulkBar() {\n  const bar = document.getElementById(\'bulk-bar\');\n  const n = selectedIds.size;\n  document.getElementById(\'bulk-count\').textContent = `${n} s\303\251lectionn\303\251${n>1?\'s\':\'\'}`;\n  bar.classList.toggle(\'show\', n > 0);\n}\n\nwindow.bulkAction = async function bulkAction(action) {\n  if (!selectedIds.size) return;\n  const ids = [...selectedIds];\n  const label = {\n    fix:\'marqu\303\251s comme r\303\251par\303\251s\', flag:\'marqu\303\251s comme faux\',\n    archive:\'archiv\303\251s\', delete:\'supprim\303\251s\',\n  }[action];\n  confirm_({\n    icon: action===\'delete\'?\'\360\237\227\221\357\270\217\':\'\342\232\240\357\270\217\',\n    title:`${action===\'delete\'?\'Supprimer\':\'Modifier\'} ${ids.length} signalement${ids.length>1?\'s\':\'\'}?`,\n    body:`Ces signalements seront ${label}.${action===\'delete\'?\' Cette action est irr\303\251versible.\':\'\'}`,\n    ok: action===\'delete\'?\'Supprimer\':action===\'archive\'?\'Archiver\':\'Confirmer\',\n    async onOk() {\n      const updates = { fix:{status:\'fixed\'}, flag:{flagged:true,status:\'flagged\'}, archive:{archived:true} }[action];\n      for (const id of ids) {\n        if (action === \'delete\') {\n          const r = allReports.find(x => x.id === id);\n          const photoUrl = safePhotoUrl(r?.photo_url);\n          if (photoUrl) {\n            const path = photoUrl.split(\'/photos/\').pop();\n            if (path) await supabase.storage.from(\'photos\').remove([path]);\n          }\n          await supabase.from(\'reports\').delete().eq(\'id\', id);\n          await supabase.from(\'audit_log\').insert({ action:\'delete\', admin: currentAdmin?.username, report_id:id });\n        } else {\n          await supabase.from(\'reports\').update(updates).eq(\'id\', id);\n          await supabase.from(\'audit_log\').insert({ action:action, admin: currentAdmin?.username, report_id:id, payload:JSON.stringify(updates) });\n        }\n      }\n      if (action === \'delete\') allReports = allReports.filter(r => !ids.includes(r.id));\n      else allReports = allReports.map(r => ids.includes(r.id) ? {...r,...updates} : r);\n      window.clearSelection();\n      window.applyFilters(); renderRecentTable(); renderPhotos(); renderFlagged(); renderArchived(); updateBadges();\n      toast(`${ids.length} signalement${ids.length>1?\'s\':\'\'} ${label}`, \'success\');\n    }\n  });\n}"
