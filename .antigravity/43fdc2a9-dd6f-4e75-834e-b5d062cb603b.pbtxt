        }
        lines {
          text: "  // Update Tabs"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const ptabs = document.querySelectorAll(\".ptab\");"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  if (ptabs.length >= 3) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ptabs[0].textContent = I18N[lang].tabFeed;"
