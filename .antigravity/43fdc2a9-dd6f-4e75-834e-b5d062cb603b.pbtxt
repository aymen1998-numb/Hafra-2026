        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  if (type === \'reports\') {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    dataToExport = allReports;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
