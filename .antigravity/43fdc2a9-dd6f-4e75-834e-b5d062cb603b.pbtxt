        }
        lines {
          text: "    <td>${getArStatus(r.status)} ${r.flagged ? `<span class=\"ar-status\" style=\"background:rgba(239,68,68,0.1);color:var(--red)\">\331\205\330\261\331\201\331\210\330\266\330\251</span>` : \'\'}</td>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
