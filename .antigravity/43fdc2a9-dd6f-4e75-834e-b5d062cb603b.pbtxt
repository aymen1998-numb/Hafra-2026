        }
        lines {
          text: "    tbody.innerHTML = `<tr><td colspan=\"3\"><div class=\"empty-state\"><div class=\"empty-txt\">\331\204\330\247 \331\212\331\210\330\254\330\257 \331\205\330\264\330\261\331\201\331\212\331\206 \330\255\330\252\331\211 \330\247\331\204\330\242\331\206</div></div></td></tr>`;"
