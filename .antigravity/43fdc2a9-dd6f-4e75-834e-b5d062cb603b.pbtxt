        }
        lines {
          text: "function starsHTML(s, sz = 14) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  return Array.from("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    { length: 5 },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
