          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "// iOS: Safari doesn\'t support beforeinstallprompt \342\200\224 show manual tip instead"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "function checkIOSInstall() {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const isSafari = /safari/i.test(navigator.userAgent) && !/chrome/i.test(navigator.userAgent);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const isStandalone = window.navigator.standalone === true;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
