          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (score  && r.score !== parseInt(score)) return false;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
