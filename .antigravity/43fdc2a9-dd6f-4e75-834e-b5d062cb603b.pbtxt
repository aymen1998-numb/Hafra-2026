    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "const fs = require(\'fs\');\nconst path = require(\'path\');\n\nconst p = path.resolve(__dirname, \'src/app.js\');\nlet code = fs.readFileSync(p, \'utf8\');\n\n// 1. Supabase import\ncode = code.replace(`import { supabase } from \"./supabase.js\";`, `// MVP Version - Supabase removed`);\n\n// 2. Auth\ncode = code.replace(/supabase\\.auth\\.onAuthStateChange[\\s\\S]*?showToast\\(\"Connexion annul\303\251e ou \303\251chou\303\251e\"\\);\\n    \\}\\n  \\}\\n\\};/m, \n`// MVP Auth\nlet currentUserEmail = localStorage.getItem(\"hafra_email\") || null;\nif (currentUserEmail) {\n  document.getElementById(\"auth-state\").textContent = currentUserEmail;\n  document.getElementById(\"auth-state\").style.color = \"var(--txt)\";\n  document.getElementById(\"auth-btn\").textContent = \"D\303\251connexion\";\n} else {\n  document.getElementById(\"auth-state\").textContent = \"Non connect\303\251\";\n  document.getElementById(\"auth-state\").style.color = \"#ef4444\";\n  document.getElementById(\"auth-btn\").textContent = \"Connexion MVP\";\n}\n\nwindow.toggleAuth = async function () {\n  if (currentUserEmail) {\n    localStorage.removeItem(\"hafra_email\");\n    currentUserEmail = null;\n    document.getElementById(\"auth-state\").textContent = \"Non connect\303\251\";\n    document.getElementById(\"auth-state\").style.color = \"#ef4444\";\n    document.getElementById(\"auth-btn\").textContent = \"Connexion MVP\";\n  } else {\n    const email = prompt(\"Mode MVP : Entrez votre email :\");\n    if (email && email.includes(\"@\")) {\n      localStorage.setItem(\"hafra_email\", email);\n      currentUserEmail = email;\n      document.getElementById(\"auth-state\").textContent = currentUserEmail;\n      document.getElementById(\"auth-state\").style.color = \"var(--txt)\";\n      document.getElementById(\"auth-btn\").textContent = \"D\303\251connexion\";\n    }\n  }\n};`);\n\n// 3. loadReports\ncode = code.replace(/async function loadReports\\(\\) \\{[\\s\\S]*?catch \\(e\\) \\{\\n    console\\.error\\(\"Error loading reports\", e\\);\\n  \\}\\n\\}/m, \n`async function loadReports() {\n  try {\n    const data = JSON.parse(localStorage.getItem(\'hafra_reports\') || \'[]\');\n    reports = data;\n  } catch (e) {\n    reports = [];\n  }\n  renderMap();\n  updateStats();\n  renderPanel();\n}`);\n\n// 4. realtime\ncode = code.replace(/function subscribeRealtime\\(\\) \\{[\\s\\S]*?\\.subscribe\\(\\);\\n\\}/m, \n`function subscribeRealtime() { }`);\n\n// 5. Upvote\ncode = code.replace(/await supabase\\.rpc\\(\"increment_votes\", \\{ row_id: id \\}\\);\\n    await supabase\\.from\\(\"confirmations\"\\)\\.insert\\(\\{ email, report_id: id \\}\\);/m, \n`    const idx = reports.findIndex(x => x.id === id);\n    if(idx !== -1) {\n        reports[idx].votes = (reports[idx].votes || 0) + 1;\n        localStorage.setItem(\"hafra_reports\", JSON.stringify(reports));\n    }`);\n\n// 6. cycleStatus\ncode = code.replace(/window\\.cycleStatus = async function cycleStatus\\(id, btn\\) \\{[\\s\\S]*?\\}\\nwindow\\.flyTo = function flyTo\\(lat, lng\\) \\{/m, \n`window.cycleStatus = async function cycleStatus(id, btn) {\n  if (!currentUserEmail) {\n    alert(\"Mode MVP: Vous devez configurer un email pour mod\303\251rer.\");\n    return;\n  }\n  const r = reports.find((x) => x.id === id);\n  if (!r) return;\n\n  const STATUS_CYCLE = {\n    active: \"assigned\",\n    assigned: \"completed\",\n    completed: \"active\",\n  };\n  const nextStatus = STATUS_CYCLE[r.status] || \"active\";\n  \n  btn.textContent = \"...\";\n  setTimeout(() => {\n    r.status = nextStatus;\n    localStorage.setItem(\"hafra_reports\", JSON.stringify(reports));\n    btn.textContent = statusLabel(nextStatus);\n    btn.className = \"status-btn status-\" + nextStatus;\n    renderMap();\n    updateStats();\n  }, 300);\n}\n\nwindow.flyTo = function flyTo(lat, lng) {`);\n\n// 7. submitReport\ncode = code.replace(/window\\.submitReport = async function submitReport\\(\\) \\{[\\s\\S]*$/, \n`window.submitReport = async function submitReport() {\n  if (!selCategory || !selStars || pendingLat === null) return;\n  if (!VALID_CATS.has(selCategory)) {\n    showToast(\"Cat\303\251gorie invalide\");\n    return;\n  }\n  if (!RateLimiter.check()) {\n    showToast(\"Trop de signalements \342\200\224 r\303\251essayez dans 10 minutes\");\n    return;\n  }\n\n  const btn = document.getElementById(\"submit-btn\");\n  const spin = document.getElementById(\"submit-spin\");\n  const txtEl = document.getElementById(\"submit-txt\");\n  btn.disabled = true;\n  spin.style.display = \"block\";\n  txtEl.textContent = \"Envoi en cours\342\200\246\";\n\n  const rawComment = document.getElementById(\"comment\").value;\n  const finalWilaya = pendingLocationName || nearestWilaya(pendingLat, pendingLng);\n\n  let base64Photo = null;\n  if(photoFile) {\n    const reader = new FileReader();\n    base64Photo = await new Promise(r => { reader.onload = () => r(reader.result); reader.readAsDataURL(photoFile); });\n  }\n\n  const payload = {\n    id: crypto.randomUUID(),\n    lat: parseFloat(pendingLat.toFixed(6)),\n    lng: parseFloat(pendingLng.toFixed(6)),\n    score: selStars,\n    category: selCategory,\n    comment: sanitiseComment(rawComment),\n    photo_url: base64Photo, // For local MVP display\n    submitter_email: currentUserEmail || \"Anonyme\",\n    wilaya: finalWilaya,\n    votes: 0,\n    status: \"active\",\n    created_at: new Date().toISOString()\n  };\n\n  const accessKey = localStorage.getItem(\"web3forms_key\") || prompt(\"MVP: Web3Forms Access Key (Gratuit sur web3forms.com) pour recevoir l\'email avec la photo ?\");\n  if(accessKey && accessKey.length > 5) {\n      localStorage.setItem(\"web3forms_key\", accessKey);\n      const formData = new FormData();\n      formData.append(\"access_key\", accessKey);\n      formData.append(\"subject\", \"Nouveau signalement: \" + CATS[selCategory].fr);\n      formData.append(\"Categorie\", CATS[selCategory].fr);\n      formData.append(\"Wilaya\", finalWilaya);\n      formData.append(\"Gravite\", selStars + \"/5\");\n      formData.append(\"Commentaire\", rawComment || \"N/A\");\n      formData.append(\"Google Maps\", \\`https://maps.google.com/?q=\\${payload.lat},\\${payload.lng}\\`);\n      \n      if(photoFile) {\n          formData.append(\"attachment\", photoFile);\n      }\n      \n      try {\n          await fetch(\"https://api.web3forms.com/submit\", { method: \"POST\", body: formData });\n      } catch (e) {\n          console.warn(\"Mail send error\", e);\n      }\n  }\n\n  reports.unshift(payload);\n  localStorage.setItem(\"hafra_reports\", JSON.stringify(reports));\n\n  RateLimiter.record();\n  closeModal();\n  renderMap();\n  updateStats();\n  renderPanel();\n  showToast(\"Envoy\303\251 avec succ\303\250s !\");\n\n  btn.disabled = false;\n  spin.style.display = \"none\";\n  txtEl.textContent = \"Signaler ce probl\303\250me\";\n\n  document.getElementById(\"photo-input\").value = \"\";\n  photoFile = null;\n  const p = document.getElementById(\"photo-preview\");\n  if(p) {\n    p.style.backgroundImage = \"none\";\n    p.style.display = \"none\";\n  }\n};\n`);\n\n// 8. Fix SUPABASE images regex matching in html cards\ncode = code.replace(/r\\.photo_url &&\\n        \\/\\^https:\\\\\\/\\\\\\/\\[a-zA-Z0-9\\._-\\]\\+\\.supabase\\.\\(co\\|in\\)\\\\\\/\\/\\.test\\(r\\.photo_url\\)/g, \"r.photo_url\");\n\n\nfs.writeFileSync(p, code);\nconsole.log(\'App MVP fixed.\');\n"
    }
