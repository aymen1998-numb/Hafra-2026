          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const json = JSON.stringify(dataToExport, null, 2);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const blob = new Blob([json], { type: \'application/json\' });"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
