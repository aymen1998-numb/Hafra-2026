        }
        lines {
          text: "window.addAdminEmail = async function() {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  if (!currentAdmin) return toast(\"Non autoris\303\251\", \"error\");"
