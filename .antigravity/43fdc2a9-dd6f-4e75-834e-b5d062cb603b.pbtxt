        lines {
          text: "  a.download = `hafra-dz-${new Date().toISOString().slice(0,10)}.geojson`;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  a.style.display = \'none\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
