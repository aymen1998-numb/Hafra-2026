        }
        lines {
          text: "  // Validate size"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  if (f.size > MAX_FILE_BYTES) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
