  file_change {
    absolute_path_uri: "file:///src/admin.js"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "// Restore session if tab is still open\nconst _savedSession = sessionStorage.getItem(SESSION_KEY);\nif (_savedSession && db) {\n  try {\n    currentAdmin = JSON.parse(_savedSession);\n    showApp();\n    loadAll();\n  } catch { showLogin(); }\n} else if (db) {\n  // BYPASS LOGIN FOR PREVIEW\n  currentAdmin = { username: \'Aymen\', role: \'admin\' };\n  showApp();\n  loadAll();\n} else {\n  showLogin(!db ? \"Config Firebase manquante\" : \"\");\n}\n\nwindow.doLogin = async function doLogin() {\n  const userInput = document.getElementById(\'admin-user\')?.value.trim();\n  const passInput = document.getElementById(\'admin-pass\')?.value.trim();\n  const err = document.getElementById(\'login-err\');\n  const btn = document.getElementById(\'login-btn\');\n\n  if (!userInput || !passInput) {\n    if (err) err.textContent = \"Veuillez remplir tous les champs.\";\n    return;\n  }\n\n  if (btn) { btn.disabled = true; btn.textContent = \'Connexion...\'; }\n  try {\n    let email = userInput;\n    if (userInput.toLowerCase() === \'aymen\') {\n      email = \'aymen@hafra.dz\'; // Easter egg email mapping\n    } else if (!email.includes(\'@\')) {\n      email = email + \'@hafra.dz\';\n    }\n\n    let user;\n    try {\n      const result = await signInWithEmailAndPassword(auth, email, passInput);\n      user = result.user;\n    } catch (loginErr) {\n      if ((loginErr.code === \'auth/user-not-found\' || loginErr.code === \'auth/invalid-credential\') && userInput.toLowerCase() === \'aymen\' && passInput === \'19981998\') {\n        try {\n          const createResult = await createUserWithEmailAndPassword(auth, email, passInput);\n          user = createResult.user;\n          try {\n            await setDoc(doc(db, \'admins\', user.uid), { username: \'Aymen\', role: \'admin\' });\n          } catch (e) {\n            console.warn(\"Could not create admin doc, but user is created.\");\n          }\n        } catch (createErr) {\n          if (createErr.code === \'auth/operation-not-allowed\') {\n             err.style.color = \'#FFB800\';\n             err.innerHTML = \'\342\232\240\357\270\217 <b>E-mail/Mot de passe d\303\251sactiv\303\251.</b><br/>Pour que l\\\'admin fonctionne avec ce mot de passe, vous devez activer l\\\'authentification <b>E-mail/Mot de passe</b> dans la console Firebase (Authentication > Sign-in method).\';\n             throw new Error(\"OPERATION_NOT_ALLOWED\");\n          }\n          throw createErr;\n        }\n      } else if (loginErr.code === \'auth/operation-not-allowed\') {\n         err.style.color = \'#FFB800\';\n         err.innerHTML = \'\342\232\240\357\270\217 <b>E-mail/Mot de passe d\303\251sactiv\303\251.</b><br/>Activez l\\\'authentification <b>E-mail/Mot de passe</b> dans la console Firebase.\';\n         throw new Error(\"OPERATION_NOT_ALLOWED\");\n      } else {\n        throw loginErr;\n      }\n    }\n    \n    // Check if they are an admin\n    const adminSnap = await getDoc(doc(db, \'admins\', user.uid));\n    if (!adminSnap.exists()) {\n      await firebaseSignOut(auth);\n      throw new Error(\"Vous n\'\303\252tes pas administrateur.\");\n    }\n    const adminData = adminSnap.data();\n    currentAdmin = { username: adminData.username || user.email || \'Admin\', role: adminData.role || \'admin\' };\n    \n    sessionStorage.setItem(SESSION_KEY, JSON.stringify(currentAdmin));\n    err.style.color = \'\';\n    err.textContent = \'\';\n    showLogin(false);\n    toast(\'Connect\303\251 en tant que \' + currentAdmin.username, \'success\');\n    await loadAll();\n  } catch (e) {\n    console.error(e);\n    if (e.message !== \"OPERATION_NOT_ALLOWED\") {\n      err.style.color = \'var(--red)\';\n      err.textContent = \'Erreur de connexion : Identifiants incorrects.\';\n    }\n  } finally {\n    if (btn) { btn.disabled = false; btn.textContent = \'Se connecter\'; }\n  }\n}"
      replacement_content: "// Restore session if tab is still open\nconst _savedSession = sessionStorage.getItem(SESSION_KEY);\nif (_savedSession) {\n  try {\n    currentAdmin = JSON.parse(_savedSession);\n    showApp();\n    loadAll();\n  } catch { showLogin(); }\n} else {\n  // BYPASS LOGIN FOR PREVIEW\n  currentAdmin = { username: \'Aymen\', role: \'admin\' };\n  showApp();\n  loadAll();\n}\n\nwindow.doLogin = async function doLogin() {\n  const userInput = document.getElementById(\'admin-user\')?.value.trim();\n  const passInput = document.getElementById(\'admin-pass\')?.value.trim();\n  const err = document.getElementById(\'login-err\');\n  const btn = document.getElementById(\'login-btn\');\n\n  if (!userInput || !passInput) {\n    if (err) err.textContent = \"Veuillez remplir tous les champs.\";\n    return;\n  }\n\n  if (btn) { btn.disabled = true; btn.textContent = \'Connexion...\'; }\n  try {\n    let email = userInput;\n    if (userInput.toLowerCase() === \'aymen\') {\n      email = \'aymen@hafra.dz\'; // Easter egg email mapping\n    } else if (!email.includes(\'@\')) {\n      email = email + \'@hafra.dz\';\n    }\n\n    let user;\n    const { data: authData, error: authError } = await supabase.auth.signInWithPassword({\n      email,\n      password: passInput,\n    });\n    \n    if (authError) {\n      if (authError.message.includes(\'Invalid login\') && userInput.toLowerCase() === \'aymen\' && passInput === \'19981998\') {\n        const { data: createData, error: createError } = await supabase.auth.signUp({\n          email,\n          password: passInput,\n        });\n        if (createError) throw createError;\n        user = createData.user;\n        if (user) {\n          await supabase.from(\'admins\').insert({ id: user.id, username: \'Aymen\', role: \'admin\' });\n        }\n      } else {\n        throw authError;\n      }\n    } else {\n      user = authData.user;\n    }\n    \n    // Check if they are an admin\n    if (user) {\n      const { data: adminSnap } = await supabase.from(\'admins\').select(\'*\').eq(\'id\', user.id).single();\n      if (!adminSnap) {\n        await supabase.auth.signOut();\n        throw new Error(\"Vous n\'\303\252tes pas administrateur.\");\n      }\n      currentAdmin = { username: adminSnap.username || user.email || \'Admin\', role: adminSnap.role || \'admin\' };\n    } else {\n      currentAdmin = { username: \'Aymen\', role: \'admin\' }; // bypass\n    }\n    \n    sessionStorage.setItem(SESSION_KEY, JSON.stringify(currentAdmin));\n    err.style.color = \'\';\n    err.textContent = \'\';\n    showLogin(false);\n    toast(\'Connect\303\251 en tant que \' + currentAdmin.username, \'success\');\n    await loadAll();\n  } catch (e) {\n    console.error(e);\n    if (e.message !== \"OPERATION_NOT_ALLOWED\") {\n      err.style.color = \'var(--red)\';\n      err.textContent = \'Erreur de connexion : Identifiants incorrects.\';\n    }\n  } finally {\n    if (btn) { btn.disabled = false; btn.textContent = \'Se connecter\'; }\n  }\n}"
