    replacement_infos {
      original_chunk {
        target_content: "function subscribeRealtime() {\n  supabase\n    .channel(\"public:reports\")\n    .on(\n      \"postgres_changes\",\n      { event: \"*\", schema: \"public\", table: \"reports\" },\n      (payload) => {\n        if (payload.eventType === \"INSERT\") {\n          const r = { ...payload.new, createdAt: payload.new.created_at };\n          if (!reports.some((x) => x.id === r.id)) {\n            reports.unshift(r);\n            renderMap();\n            updateStats();\n            renderPanel();\n          }\n        } else if (payload.eventType === \"UPDATE\") {\n          const r = { ...payload.new, createdAt: payload.new.created_at };\n          const idx = reports.findIndex((x) => x.id === r.id);\n          if (idx > -1) {\n            reports[idx] = Object.assign(reports[idx], r);\n            renderMap();\n            updateStats();\n            renderPanel();\n          }\n        }\n      },\n    )\n    .subscribe((status) => {\n      if (status === \"SUBSCRIBED\") {\n        console.log(\"Realtime subscribed\");\n      }\n    });\n}"
        replacement_content: "function subscribeRealtime() {\n  // Mode MVP - realtime network sync is disabled, operates locally.\n}"
      }
      num_matches: 1
