        }
        lines {
          text: "  const svg = `<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 40 50\" width=\"40\" height=\"50\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
