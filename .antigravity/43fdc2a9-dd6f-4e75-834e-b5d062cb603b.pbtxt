        }
        lines {
          text: "  reports:  { title:\'\330\247\331\204\330\264\331\203\330\247\331\210\331\211\', sub:\'\330\254\331\205\331\212\330\271 \330\252\331\202\330\247\330\261\331\212\330\261 \330\247\331\204\331\205\331\210\330\247\330\267\331\206\331\212\331\206\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  photos:   { title:\'\331\205\330\271\330\261\330\266 \330\247\331\204\330\265\331\210\330\261\', sub:\'\330\247\331\204\330\265\331\210\330\261 \330\247\331\204\331\205\330\261\331\201\331\202\330\251\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
