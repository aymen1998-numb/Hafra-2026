        lines {
          text: "    (_, i) =>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      `<span style=\"font-size:${sz}px;filter:${i < s ? \"none\" : \"grayscale(1) opacity(.2)\"}\">\342\255\220</span>`,"
