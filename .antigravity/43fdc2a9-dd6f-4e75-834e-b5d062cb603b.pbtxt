        }
        lines {
          text: "  if (!el) return;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const email = el.value.trim().toLowerCase();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  if (!email || !email.includes(\'@\')) return toast(\"\330\247\331\204\330\261\330\254\330\247\330\241 \330\245\330\257\330\256\330\247\331\204 \330\250\330\261\331\212\330\257 \330\245\331\204\331\203\330\252\330\261\331\210\331\206\331\212 \330\265\330\255\331\212\330\255\", \"error\");"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const btn = event.currentTarget;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const oldTxt = btn.textContent;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  btn.disabled = true; btn.textContent = \'...\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  try {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    await setDoc(doc(db, \'allowed_emails\', email), { "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "       addedBy: currentAdmin.username, "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "       createdAt: serverTimestamp() "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
