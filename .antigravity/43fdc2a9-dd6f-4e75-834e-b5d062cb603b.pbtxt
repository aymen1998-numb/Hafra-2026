          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    <path d=\"M20 0C9 0 0 9.4 0 21C0 36 20 50 20 50S40 36 40 21C40 9.4 31 0 20 0Z\" fill=\"${sc}\" filter=\"url(#${fid})\" opacity=\".92\"/>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
