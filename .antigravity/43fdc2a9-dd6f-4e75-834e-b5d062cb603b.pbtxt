      replacement_content: "  const selW = document.getElementById(\'f-wilaya\');\n  const dashW = document.getElementById(\'f-dash-wilaya\');\n  \n  const optionsHTML = \'<option value=\"\">\331\203\331\204 \330\247\331\204\331\210\331\204\330\247\331\212\330\247\330\252</option>\' + [...knownStates].sort().map(w => `<option value=\"${esc(w)}\">${esc(w)}</option>`).join(\'\');\n  \n  if (selW && changed) {\n    const prevW = selW.value;\n    selW.innerHTML = optionsHTML;\n    selW.value = prevW;\n  }\n  if (dashW && changed) {\n    const prevDW = dashW.value;\n    dashW.innerHTML = optionsHTML;\n    dashW.value = prevDW;\n  }\n  \n  if (changed) {\n    updateCommunesFilter();\n    updateDashCommunesFilter();\n  }\n}\n\nwindow.updateDashCommunesFilter = function updateDashCommunesFilter() {\n  const dashW = document.getElementById(\'f-dash-wilaya\');\n  const dashC = document.getElementById(\'f-dash-commune\');\n  if (!dashC) return;\n  \n  const currentW = dashW ? dashW.value : \'\';\n  const prevC = dashC.value;\n  let allowedPlaces = new Set();\n  \n  if (currentW && stateToPlaces[currentW]) {\n    allowedPlaces = stateToPlaces[currentW];\n  } else if (!currentW) {\n    allowedPlaces = knownPlaces;\n  }\n\n  dashC.innerHTML = \'<option value=\"\">\331\203\331\204 \330\247\331\204\330\250\331\204\330\257\331\212\330\247\330\252</option>\' + [...allowedPlaces].sort().map(c => `<option value=\"${esc(c)}\">${esc(c)}</option>`).join(\'\');\n  \n  if (allowedPlaces.has(prevC)) {\n    dashC.value = prevC;\n  } else {\n    dashC.value = \'\';\n  }\n}\n\nwindow.applyDashboardFilters = function applyDashboardFilters() {\n  const dashW = document.getElementById(\'f-dash-wilaya\');\n  const dashC = document.getElementById(\'f-dash-commune\');\n  const isWilayaTrigger = document.activeElement === dashW;\n  if (isWilayaTrigger) {\n    updateDashCommunesFilter();\n  }\n  \n  const wilaya = dashW ? dashW.value : \'\';\n  const commune = dashC ? dashC.value : \'\';\n  \n  // Update stats based on these filters?\n  // Wait, `recalculateStats()` uses allReports, let\'s create a filtered version just for dashboard display\n  const dashReports = allReports.filter(r => {\n    const parts = (r.wilaya || \'\').split(\', \');\n    const rPlace = parts.length === 2 ? parts[0].trim() : \'\';\n    const rState = parts.length === 2 ? parts[1].trim() : parts[0].trim();\n    if (wilaya && rState !== wilaya) return false;\n    if (commune && rPlace !== commune) return false;\n    return true;\n  });\n  \n  // Re-render dashboard components with dashReports instead of allReports\n  // Wait, let\'s check what functions we need to call to re-render stats and map.\n  renderDashboard(dashReports);\n}\n"
