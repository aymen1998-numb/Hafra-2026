        lines {
          text: "    <td style=\"font-weight:700\"><span style=\"color:var(--dim);margin-left:4px\">\360\237\223\215</span> ${esc(r.wilaya||\'\342\200\224\')}</td>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    <td style=\"color:var(--yellow);font-weight:700\">${r.score} \342\255\220</td>"
