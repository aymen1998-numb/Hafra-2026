      target_content: "window.removeAdminEmail = async function(emailId) {\n  if (!currentAdmin) return toast(\"Non autoris\303\251\", \"error\");\n  if (!confirm(\'\331\207\331\204 \330\243\331\206\330\252 \331\205\330\252\330\243\331\203\330\257 \331\205\331\206 \330\255\330\260\331\201 \331\207\330\260\330\247 \330\247\331\204\331\205\330\264\330\261\331\201\330\237 (\' + emailId + \')\')) return;\n  try {\n    await deleteDoc(doc(db, \'allowed_emails\', emailId));\n    toast(\"\330\252\331\205 \330\255\330\260\331\201 \330\247\331\204\331\205\330\264\330\261\331\201\", \"success\");\n  } catch(e) {\n    handleFirestoreError(e, OperationType.DELETE, \'allowed_emails\');\n  }\n}"
