          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    .replace(/\"/g, \"&quot;\")"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    .replace(/\'/g, \"&#039;\");"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
