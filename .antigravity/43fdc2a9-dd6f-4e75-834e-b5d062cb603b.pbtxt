        }
        lines {
          text: "  "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const optionsHTML = \'<option value=\"\">\331\203\331\204 \330\247\331\204\331\210\331\204\330\247\331\212\330\247\330\252</option>\' + [...knownStates].sort().map(w => `<option value=\"${esc(w)}\">${esc(w)}</option>`).join(\'\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
