          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  document.getElementById(\'ep-id\').textContent = r.id;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
