          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "window.pwaDismiss = function pwaDismiss() {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  hidePwaBanner();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
