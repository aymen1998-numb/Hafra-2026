        lines {
          text: "    console.warn(\"[hafra] Reverse geocoding failed\", err);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  return nearestWilaya(lat, lng);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
