        }
        lines {
          text: "  onSnapshot(q, (snapshot) => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    snapshot.docChanges().forEach((change) => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
