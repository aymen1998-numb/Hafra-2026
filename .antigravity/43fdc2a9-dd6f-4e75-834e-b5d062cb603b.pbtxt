    replacement_chunks {
      replacement_content: "import * as L from \"leaflet\";\nimport \"leaflet/dist/leaflet.css\";\n\n// Dynamic imports for plugins\nawait import(\"leaflet.heat\");\nimport \"leaflet.markercluster\";\nimport \"leaflet.markercluster/dist/MarkerCluster.css\";\nimport \"leaflet.markercluster/dist/MarkerCluster.Default.css\";\n\nwindow.L = L;\n\n// Fix Leaflet Default Icon path issues with bundlers\ndelete L.Icon.Default.prototype._getIconUrl;\nL.Icon.Default.mergeOptions({\n  iconRetinaUrl: \"https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon-2x.png\",\n  iconUrl: \"https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon.png\",\n  shadowUrl: \"https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png\",\n});\n\n\"use strict\";\n\nconst CATS = {\n  pothole: { fr: \"Nid-de-poule\", ico: \"\360\237\225\263\", col: \"#EF4444\" },\n  cracks: { fr: \"Fissures\", ico: \"\360\237\252\250\", col: \"#F97316\" },\n  lighting: { fr: \"\303\211clairage\", ico: \"\360\237\214\221\", col: \"#818CF8\" },\n  signage: { fr: \"Signalisation\", ico: \"\360\237\232\247\", col: \"#FBBF24\" },\n  flooding: { fr: \"Inondation\", ico: \"\360\237\214\212\", col: \"#38BDF8\" },\n  utility: { fr: \"ADE / SEAAL\", ico: \"\360\237\222\247\", col: \"#34D399\" },\n};\n\nlet map, reportLayer, heatLayer;\nlet reports = [];\nlet pendingMarker = null;\nlet pendingLat = null, pendingLng = null;\nlet selCategory = null;\nlet selStars = 0;\nlet photoFile = null;\n\n// UI Helpers\nfunction showToast(msg) {\n  const t = document.getElementById(\"toast\");\n  t.textContent = msg;\n  t.className = \"show\";\n  setTimeout(() => (t.className = \"\"), 3000);\n}\n\nfunction hideLoader() {\n  const el = document.getElementById(\"app-loading\");\n  if (el) {\n    el.classList.add(\"hidden\");\n    setTimeout(() => el.remove(), 500);\n  }\n}\n\n// Map Initialization\nasync function initMap() {\n  map = L.map(\"map\", { zoomControl: false }).setView([36.75, 3.05], 11);\n  L.tileLayer(\"https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png\", {\n    attribution: \'\302\251 OpenStreetMap \302\251 CARTO\',\n    subdomains: \'abcd\',\n    maxZoom: 19\n  }).addTo(map);\n\n  map.on(\"click\", (e) => setLocation(e.latlng.lat, e.latlng.lng));\n\n  reportLayer = L.markerClusterGroup({ disableClusteringAtZoom: 15 });\n  map.addLayer(reportLayer);\n\n  loadReports();\n}\n\nfunction setLocation(lat, lng) {\n  pendingLat = lat;\n  pendingLng = lng;\n  if (!pendingMarker) {\n    pendingMarker = L.marker([lat, lng], { draggable: true }).addTo(map);\n    pendingMarker.on(\'dragend\', function (e) {\n      pendingLat = pendingMarker.getLatLng().lat;\n      pendingLng = pendingMarker.getLatLng().lng;\n      updateLocationUI();\n    });\n  } else {\n    pendingMarker.setLatLng([lat, lng]);\n  }\n  updateLocationUI();\n}\n\nfunction updateLocationUI() {\n  document.getElementById(\"loc-coords\").textContent = `${pendingLat.toFixed(5)}, ${pendingLng.toFixed(5)}`;\n  document.getElementById(\"loc-wilaya\").textContent = \"Position s\303\251lectionn\303\251e (appuyez sur la carte pour changer)\";\n}\n\nwindow.locateBtnClick = function () {\n  const btn = document.getElementById(\"btn-locate\");\n  if (!navigator.geolocation) {\n    showToast(\"GPS non disponible\");\n    return;\n  }\n  btn.textContent = \"\342\217\263\";\n  navigator.geolocation.getCurrentPosition(\n    (pos) => {\n      btn.textContent = \"\360\237\223\215\";\n      map.flyTo([pos.coords.latitude, pos.coords.longitude], 15);\n    },\n    (err) => {\n      btn.textContent = \"\360\237\223\215\";\n      showToast(\"Erreur GPS: \" + err.message);\n    },\n    { enableHighAccuracy: true }\n  );\n};\n\nwindow.useMyLocation = function () {\n  if (!navigator.geolocation) {\n    showToast(\"GPS non disponible\");\n    return;\n  }\n  const btn = document.getElementById(\"gps-btn\");\n  btn.textContent = \"\360\237\223\241 Localisation\342\200\246\";\n  navigator.geolocation.getCurrentPosition(\n    (pos) => {\n      btn.textContent = \"\360\237\223\215 Ma position\";\n      setLocation(pos.coords.latitude, pos.coords.longitude);\n      map.flyTo([pos.coords.latitude, pos.coords.longitude], 15);\n    },\n    (err) => {\n        btn.textContent = \"\360\237\223\215 Ma position\";\n        showToast(\"Erreur GPS\");\n    },\n    { enableHighAccuracy: true }\n  );\n};\n\nwindow.toggleAdd = function () {\n  document.getElementById(\"overlay\").style.display = \"flex\";\n  document.getElementById(\"modal\").style.transform = \"translateY(0)\";\n  if (!pendingLat) {\n    setLocation(map.getCenter().lat, map.getCenter().lng);\n  }\n};\n\nwindow.closeModal = function () {\n  document.getElementById(\"modal\").style.transform = \"translateY(100%)\";\n  setTimeout(() => {\n    document.getElementById(\"overlay\").style.display = \"none\";\n  }, 300);\n};\n\nwindow.selCat = function (cat, el) {\n  selCategory = cat;\n  document.querySelectorAll(\".cat-btn\").forEach(b => b.classList.remove(\"checked\"));\n  el.classList.add(\"checked\");\n  checkSubmit();\n};\n\nwindow.setStar = function (n) {\n  selStars = n;\n  const stars = document.querySelectorAll(\".star-btn\");\n  stars.forEach((s, i) => {\n    s.style.opacity = i < n ? \"1\" : \"0.3\";\n  });\n  document.getElementById(\"star-label\").textContent = [\"Ignorer\", \"Mauvaise\", \"G\303\252nante\", \"Dangereuse\", \"Impraticable\", \"Catastrophique\"][n];\n  checkSubmit();\n};\n\nwindow.onPhoto = function (input) {\n  if (input.files && input.files[0]) {\n    photoFile = input.files[0];\n    const reader = new FileReader();\n    reader.onload = function(e) {\n      const p = document.getElementById(\"photo-prev\");\n      if(p) {\n          p.src = e.target.result;\n          p.style.display = \"block\";\n      }\n      const pc = document.getElementById(\"photo-inner\");\n      if(pc) pc.style.opacity = 0;\n      document.getElementById(\"photo-rm\").style.display = \"flex\";\n    };\n    reader.readAsDataURL(photoFile);\n  }\n};\n\nwindow.removePhoto = function (e) {\n  e.preventDefault();\n  photoFile = null;\n  document.getElementById(\"photo-input\").value = \"\";\n  const p = document.getElementById(\"photo-prev\");\n  if(p) { p.src = \"\"; p.style.display = \"none\"; }\n  const pc = document.getElementById(\"photo-inner\");\n  if(pc) pc.style.opacity = 1;\n  document.getElementById(\"photo-rm\").style.display = \"none\";\n};\n\nwindow.updateCharCount = function(el) {\n  document.getElementById(\"char-count\").textContent = `${el.value.length} / 300`;\n};\n\nfunction checkSubmit() {\n  document.getElementById(\"submit-btn\").disabled = !(selCategory && selStars > 0 && pendingLat);\n}\n\n// \342\224\200\342\224\200 SUBMIT / MVP LOGIC \342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\nasync function resizeImage(file) {\n  return new Promise((resolve) => {\n    const reader = new FileReader();\n    reader.onload = (e) => {\n      const img = document.createElement(\"img\");\n      img.onload = () => {\n        const canvas = document.createElement(\'canvas\');\n        let ctx = canvas.getContext(\"2d\");\n        ctx.drawImage(img, 0, 0);\n        \n        let MAX_WIDTH = 800;\n        let MAX_HEIGHT = 800;\n        let width = img.width;\n        let height = img.height;\n        \n        if (width > height) {\n          if (width > MAX_WIDTH) { height *= MAX_WIDTH / width; width = MAX_WIDTH; }\n        } else {\n          if (height > MAX_HEIGHT) { width *= MAX_HEIGHT / height; height = MAX_HEIGHT; }\n        }\n        \n        canvas.width = width;\n        canvas.height = height;\n        ctx = canvas.getContext(\"2d\");\n        ctx.drawImage(img, 0, 0, width, height);\n        \n        resolve(canvas.toDataURL(file.type || \'image/jpeg\', 0.7));\n      }\n      img.src = e.target.result;\n    };\n    reader.readAsDataURL(file);\n  });\n}\n\nwindow.submitReport = async function submitReport() {\n  if (!selCategory || !selStars || !pendingLat) return;\n  \n  const btn = document.getElementById(\"submit-btn\");\n  const spin = document.getElementById(\"submit-spin\");\n  const txtEl = document.getElementById(\"submit-txt\");\n  btn.disabled = true;\n  spin.style.display = \"block\";\n  txtEl.textContent = \"Envoi en cours\342\200\246\";\n\n  const rawComment = document.getElementById(\"comment\").value;\n  let base64Photo = photoFile ? await resizeImage(photoFile) : null;\n  \n  const payload = {\n    id: crypto.randomUUID(),\n    lat: pendingLat,\n    lng: pendingLng,\n    score: selStars,\n    category: selCategory,\n    comment: rawComment.replace(/<[^>]*>/g, \"\").trim().slice(0, 300),\n    photo_url: base64Photo,\n    wilaya: \"Position GPS\",\n    votes: 0,\n    status: \"active\",\n    created_at: new Date().toISOString()\n  };\n\n  const accessKey = localStorage.getItem(\"web3forms_key\") || prompt(\"Mode MVP - Entrez la Web3Forms Access Key (venant de web3forms.com) pour recevoir les signalements par e-mail\");\n  if (accessKey && accessKey.length > 5) {\n      localStorage.setItem(\"web3forms_key\", accessKey);\n      const fd = new FormData();\n      fd.append(\"access_key\", accessKey);\n      fd.append(\"subject\", \"Nouveau signalement Hafra: \" + CATS[selCategory].fr);\n      fd.append(\"Gravite\", selStars + \"/5\");\n      fd.append(\"Maps\", \\`https://maps.google.com/?q=\\${payload.lat},\\${payload.lng}\\`);\n      fd.append(\"Commentaire\", payload.comment || \"N/A\");\n      if (document.getElementById(\"photo-input\").files[0]) {\n          fd.append(\"attachment\", document.getElementById(\"photo-input\").files[0]);\n      }\n      \n      try {\n          await fetch(\"https://api.web3forms.com/submit\", { method: \"POST\", body: fd });\n      } catch(e) {\n          console.error(\"Web3Forms error\", e);\n      }\n  }\n\n  reports.unshift(payload);\n  localStorage.setItem(\"hafra_reports\", JSON.stringify(reports));\n\n  closeModal();\n  renderMap();\n  updateStats();\n  renderPanel();\n  showToast(\"Signalement enregistr\303\251 (localement)\");\n\n  btn.disabled = false;\n  spin.style.display = \"none\";\n  txtEl.textContent = \"Soumettre le signalement\";\n  document.getElementById(\"comment\").value = \"\";\n  window.removePhoto({preventDefault:()=>{}});\n};\n\nfunction loadReports() {\n  try {\n    const data = JSON.parse(localStorage.getItem(\"hafra_reports\") || \"[]\");\n    reports = data || [];\n  } catch(e) {\n    reports = [];\n  }\n  renderMap();\n  updateStats();\n  renderPanel();\n  hideLoader();\n}\n\nfunction updateStats() {\n  document.getElementById(\"h-total\").textContent = reports.length;\n  if(!reports.length) {\n    document.getElementById(\"h-avg\").textContent = \"\342\200\224\";\n    document.getElementById(\"h-bad\").textContent = \"\342\200\224\";\n    return;\n  }\n  let sum = 0, bad = 0;\n  for(const r of reports) {\n      sum += r.score;\n      if(r.score >= 4) bad++;\n  }\n  document.getElementById(\"h-avg\").textContent = (sum / reports.length).toFixed(1);\n  document.getElementById(\"h-bad\").textContent = bad;\n}\n\nfunction renderMap() {\n  reportLayer.clearLayers();\n  \n  if (heatLayer) map.removeLayer(heatLayer);\n  const heatData = reports.map(r => [r.lat, r.lng, r.score * 20]);\n  heatLayer = L.heatLayer(heatData, { radius: 25, blur: 15, maxZoom: 14 }).addTo(map);\n\n  reports.forEach(r => {\n    const cat = CATS[r.category];\n    const icon = L.divIcon({\n      className: \'hf-marker\',\n      html: \\`<div class=\"hf-pin\" style=\"background:\\${cat?.col || \'#111\'}\">\\${cat?.ico || \'\360\237\223\215\'}</div>\\`,\n      iconSize: [32, 40], iconAnchor: [16, 40]\n    });\n    \n    const m = L.marker([r.lat, r.lng], { icon });\n    m.bindPopup(\\`\n      <div style=\"font-family: \'Cairo\'\">\n        <b>\\${cat?.fr} (\\${r.score}/5)</b><br>\n        \\${r.comment ? \'<i>\' + r.comment + \'</i><br>\' : \'\'}\n        <small>\\${new Date(r.created_at).toLocaleDateString()}</small>\n      </div>\n    \\`);\n    reportLayer.addLayer(m);\n  });\n}\n\nfunction renderPanel() {\n  const pb = document.getElementById(\"pbody\");\n  if(!pb) return;\n  pb.innerHTML = \"\";\n  if(reports.length === 0) {\n      pb.innerHTML = \"<div style=\'padding:20px; text-align:center; color:var(--dim)\'>Aucun signalement.</div>\";\n      return;\n  }\n  reports.slice(0, 50).forEach(r => {\n      const cat = CATS[r.category];\n      const div = document.createElement(\"div\");\n      div.className = \"rcard\";\n      let imgHtml = r.photo_url ? \\`<img src=\"\\${r.photo_url}\" class=\"rcard-photo\" style=\"width:100%; height:120px; object-fit:cover; border-radius:8px; margin-top:8px;\">\\` : \"\";\n      div.innerHTML = \\`\n        <div class=\"rcard-top\">\n          <div class=\"rcard-ico\" style=\"background:\\${cat?.col}\">\\${cat?.ico}</div>\n          <div class=\"rcard-meta\">\n            <div class=\"rcard-title\">\\${cat?.fr} <span style=\"float:right\">\342\255\220 \\${r.score}/5</span></div>\n            <div class=\"rcard-sub\">\\${new Date(r.created_at).toLocaleString()}</div>\n          </div>\n        </div>\n        \\${r.comment ? \\`<div class=\"rcard-body\">\\${r.comment}</div>\\` : \'\'}\n        \\${imgHtml}\n        <button style=\"margin-top:10px; width:100%; padding:8px; background:var(--bg2); border:none; border-radius:6px; color:var(--txt)\" onclick=\"map.flyTo([\\${r.lat}, \\${r.lng}], 16)\">Voir sur la carte</button>\n      \\`;\n      pb.appendChild(div);\n  });\n}\n\nwindow.togglePanel = function() {\n    const panel = document.getElementById(\"panel\");\n    panel.classList.toggle(\"open\");\n}\n\nwindow.setTab = function(tab, el) { /* simple MVP feed */ }\nwindow.toggleAuth = function() {\n    localStorage.removeItem(\"web3forms_key\");\n    showToast(\"Cl\303\251 Web3Forms effac\303\251e.\");\n}\nwindow.toggleTheme = function() {\n   document.documentElement.classList.toggle(\"light\");\n   localStorage.setItem(\"hafra-theme\", document.documentElement.classList.contains(\"light\") ? \"light\" : \"dark\");\n}\n\ninitMap();\n"
    }
