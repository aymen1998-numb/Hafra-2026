          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  try {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    await setDoc(doc(db, \'allowed_emails\', email), { "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
