        lines {
          text: "window.showPage = function showPage(name, navEl) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  document.querySelectorAll(\'.page\').forEach(p => p.classList.remove(\'active\'));"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
