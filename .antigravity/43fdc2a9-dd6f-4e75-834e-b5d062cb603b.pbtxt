        }
        lines {
          text: "window.saveReport = async function saveReport() {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  if (!editingReport) return;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
