          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  setTimeout(() => URL.revokeObjectURL(url), 10000);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
