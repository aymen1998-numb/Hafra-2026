m\303\251s d\303\251finitivement.\',\n    ok:\'Supprimer\',\n    async onOk() {\n      const id = editingReport.id;\n      const photoUrl = safePhotoUrl(editingReport.photo_url);\n      window.closeEditor();\n      try {\n        if (photoUrl) {\n          const path = photoUrl.split(\'/photos/\').pop();\n          if (path) await supabase.storage.from(\'photos\').remove([path]);\n        }\n        await supabase.from(\'reports\').delete().eq(\'id\', id);\n        await supabase.from(\'audit_log\').insert({ action:\'delete\', admin: currentAdmin?.username, report_id: id });\n        allReports = allReports.filter(r => r.id !== id);\n        window.applyFilters(); renderRecentTable(); renderPhotos(); renderFlagged(); renderArchived(); updateBadges();\n        toast(\'Signalement supprim\303\251\', \'success\');\n      } catch (err) {\n        toast(\'Erreur: \' + err.message, \'error\');\n      }\n    }\n  });\n}\n\n// \342\224\200\342\224\200 QUICK ROW ACTIONS \342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\nasync function quickAction(id, updates, action) {\n  try {\n    await supabase.from(\'reports\').update(updates).eq(\'id\', id);\n    await supabase.from(\'audit_log\').insert({ action: action, admin: currentAdmin?.username, report_id: id, payload: JSON.stringify(updates) });\n    const idx = allReports.findIndex(r => r.id === id);\n   