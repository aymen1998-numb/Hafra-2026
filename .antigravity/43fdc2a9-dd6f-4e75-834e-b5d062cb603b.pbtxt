  file_change {
    absolute_path_uri: "file:///supabase_init.sql"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "-- Run this in the Supabase SQL Editor\n\n-- 1. Reports table\nCREATE TABLE reports (\n  id uuid DEFAULT gen_random_uuid() PRIMARY KEY,\n  comment text,\n  category text,\n  status text DEFAULT \'active\',\n  wilaya text,\n  lat float,\n  lng float,\n  photo_url text,\n  submitter_email text,\n  score int DEFAULT 3,\n  votes int DEFAULT 0,\n  flagged boolean DEFAULT false,\n  archived boolean DEFAULT false,\n  admin_notes text,\n  created_at timestamp with time zone DEFAULT now()\n);\n\n-- 2. Confirmations table\nCREATE TABLE confirmations (\n  id uuid DEFAULT gen_random_uuid() PRIMARY KEY,\n  email text,\n  report_id uuid REFERENCES reports(id) ON DELETE CASCADE,\n  created_at timestamp with time zone DEFAULT now()\n);\n\n-- 3. Audit logs table\nCREATE TABLE audit_log (\n  id uuid DEFAULT gen_random_uuid() PRIMARY KEY,\n  action text,\n  admin text,\n  report_id text, -- Can be uuid string, storing as text for flexibility\n  payload jsonb,\n  created_at timestamp with time zone DEFAULT now()\n);\n\n-- 4. Admins table\nCREATE TABLE admins (\n  id uuid PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE,\n  username text,\n  role text DEFAULT \'admin\'\n);\n\n-- 5. Allowed emails table\nCREATE TABLE allowed_emails (\n  email text PRIMARY KEY,\n  added_by text,\n  created_at timestamp with time zone DEFAULT now()\n);\n\n-- Turn on Row Level Security (RLS)\nALTER TABLE reports ENABLE ROW LEVEL SECURITY;\nALTER TABLE confirmations ENABLE ROW LEVEL SECURITY;\nALTER TABLE audit_log ENABLE ROW LEVEL SECURITY;\nALTER TABLE admins ENABLE ROW LEVEL SECURITY;\nALTER TABLE allowed_emails ENABLE ROW LEVEL SECURITY;\n\n-- ----------------------------------------------------\n-- SECURITY POLICIES (Simple public full access for demo/prototype mapping previous free tier rules)\n-- Modify these for production!\n\n-- Reports: Public can read all, insert, update (limit fields in real app)\nCREATE POLICY \"Public Read Reports\" ON reports FOR SELECT USING (true);\nCREATE POLICY \"Public Insert Reports\" ON reports FOR INSERT WITH CHECK (true);\nCREATE POLICY \"Public Update Reports\" ON reports FOR UPDATE USING (true);\nCREATE POLICY \"Public Delete Reports\" ON reports FOR DELETE USING (true);\n\n-- Confirmations: Public can insert/read\nCREATE POLICY \"Public Read Confirmations\" ON confirmations FOR SELECT USING (true);\nCREATE POLICY \"Public Insert Confirmations\" ON confirmations FOR INSERT WITH CHECK (true);\n\n-- Admin related (Allow all for simplicity initially, secure as needed)\nCREATE POLICY \"Public All Audit\" ON audit_log FOR ALL USING (true);\nCREATE POLICY \"Public All Admins\" ON admins FOR ALL USING (true);\nCREATE POLICY \"Public All Allowed Emails\" ON allowed_emails FOR ALL USING (true);\n\n-- ----------------------------------------------------\n-- Storage Bucket for photos\nINSERT INTO storage.buckets (id, name, public) VALUES (\'photos\', \'photos\', true) ON CONFLICT DO NOTHING;\n\nCREATE POLICY \"Public access to view photos\" ON storage.objects FOR SELECT USING (bucket_id = \'photos\');\nCREATE POLICY \"Public access to upload photos\" ON storage.objects FOR INSERT WITH CHECK (bucket_id = \'photos\');\nCREATE POLICY \"Public access to delete photos\" ON storage.objects FOR DELETE USING (bucket_id = \'photos\');\nCREATE POLICY \"Public access to update photos\" ON storage.objects FOR UPDATE USING (bucket_id = \'photos\');\n\n-- Helper function to increment votes\nCREATE OR REPLACE FUNCTION increment_votes(row_id uuid)\nRETURNS void AS $$\nBEGIN\n  UPDATE reports\n  SET votes = votes + 1\n  WHERE id = row_id;\nEND;\n$$ LANGUAGE plpgsql;\n\n-- Realtime Setup\nalter publication supabase_realtime add table reports;\nalter publication supabase_realtime add table audit_log;\nalter publication supabase_realtime add table allowed_emails;\n"
    }
    diff {
      unified_diff {
        lines {
          text: "-- Run this in the Supabase SQL Editor"
