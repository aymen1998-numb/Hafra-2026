          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      <td><span class=\"cat-tag\" style=\"color:${c.col};border-color:${c.col}40;background:${c.col}12\">${c.ico} ${esc(c.fr)}</span></td>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
