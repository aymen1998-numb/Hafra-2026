          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  admins:   { title:\'\330\247\331\204\331\205\330\264\330\261\331\201\331\212\331\206\', sub:\'\330\265\331\204\330\247\330\255\331\212\330\247\330\252 \330\247\331\204\331\210\331\204\331\210\330\254\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  audit:    { title:\'\330\263\330\254\331\204 \330\247\331\204\330\271\331\205\331\204\331\212\330\247\330\252\', sub:\'\330\271\331\205\331\204\331\212\330\247\330\252 \330\247\331\204\331\205\330\264\330\261\331\201\331\212\331\206\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "};"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "window.showPage = function showPage(name, navEl) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  document.querySelectorAll(\'.page\').forEach(p => p.classList.remove(\'active\'));"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  document.querySelectorAll(\'.nav-item\').forEach(n => n.classList.remove(\'active\'));"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  document.getElementById(\'page-\'+name)?.classList.add(\'active\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  navEl?.classList.add(\'active\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const cfg = PAGE_TITLES[name] || {};"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  document.getElementById(\'topbar-title\').textContent = cfg.title || name;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  document.getElementById(\'topbar-sub\').textContent   = cfg.sub   || \'\';"
