    replacement_chunks {
      target_content: "  try {\n    await updateDoc(doc(db, \'reports\', editingReport.id), updates);\n    await addDoc(collection(db, \'audit_log\'), { action:\'edit\', admin: currentAdmin?.username, report_id: editingReport.id, payload: updates, createdAt: serverTimestamp() });\n    \n    const idx = allReports.findIndex(r => r.id === editingReport.id);\n    if (idx > -1) allReports[idx] = { ...allReports[idx], ...updates };\n    window.applyFilters(); renderRecentTable(); renderPhotos();\n    toast(\'Signalement mis \303\240 jour\', \'success\');\n    window.closeEditor();\n  } catch (err) {\n    toast(\'Erreur: \' + err.message, \'error\');\n  } finally {\n    btn.disabled = false; btn.textContent = \'Enregistrer\';\n  }\n}\n\nwindow.toggleFlag = async function toggleFlag() {\n  if (!editingReport) return;\n  const newFlagged = !editingReport.flagged;\n  try {\n    await updateDoc(doc(db, \'reports\', editingReport.id), { flagged: newFlagged });\n    await addDoc(collection(db, \'audit_log\'), { action: newFlagged ? \'flag\' : \'unflag\', admin: currentAdmin?.username, report_id: editingReport.id, createdAt: serverTimestamp() });\n    editingReport.flagged = newFlagged;\n    const btn = document.getElementById(\'ep-flag-btn\');\n    btn?.classList.toggle(\'flagged\', newFlagged);\n    btn.textContent = newFlagged ? \'\342\234\205 Valider\' : \'\360\237\232\251 Signaler faux\';\n    const idx = allReports.findIndex(r => r.id === editingReport.id);\n    if (idx > -1) allReports[idx].flagged = newFlagged;\n    renderFlagged(); updateBadges();\n    toast(newFlagged ? \'Marqu\303\251 comme faux signalement\' : \'Signalement valid\303\251\', \'info\');\n  } catch (err) {\n    toast(\'Erreur: \' + err.message, \'error\');\n  }\n}\n\nwindow.deleteReport = async function deleteReport() {\n  if (!editingReport) return;\n  confirm_({\n    icon:\'\360\237\227\221\357\270\217\', title:\'Supprimer ce signalement ?\',\n    body:\'Cette action est irr\303\251versible. Le signalement et sa photo seront supprim\303\251s d\303\251finitivement.\',\n    ok:\'Supprimer\',\n    async onOk() {\n      const id = editingReport.id;\n      const photoUrl = safePhotoUrl(editingReport.photo_url);\n      window.closeEditor();\n      try {\n        if (photoUrl) {\n          const path = photoUrl.split(\'/road-photos/\').pop();\n          if (path) await deleteObject(ref(storage, \'road-photos/\' + path));\n        }\n        await deleteDoc(doc(db, \'reports\', id));\n        await addDoc(collection(db, \'audit_log\'), { action:\'delete\', admin: currentAdmin?.username, report_id: id, createdAt: serverTimestamp() });\n        allReports = allReports.filter(r => r.id !== id);\n        window.applyFilters(); renderRecentTable(); renderPhotos(); renderFlagged(); renderArchived(); updateBadges();\n        toast(\'Signalement supprim\303\251\', \'success\');\n      } catch (err) {\n        toast(\'Erreur: \' + err.message, \'error\');\n      }\n    }\n  });\n}\n\n// \342\224\200\342\224\200 QUICK ROW ACTIONS \342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\nasync function quickAction(id, updates, action) {\n  try {\n    await updateDoc(doc(db, \'reports\', id), updates);\n    await addDoc(collection(db, \'audit_log\'), { action: action, admin: currentAdmin?.username, report_id: id, payload: updates, createdAt: serverTimestamp() });\n    const idx = allReports.findIndex(r => r.id === id);\n    if (idx > -1) allReports[idx] = { ...allReports[idx], ...updates };\n    window.applyFilters(); renderRecentTable(); renderPhotos(); renderFlagged(); renderArchived(); updateBadges();\n    return true;\n  } catch (err) {\n    toast(\'Erreur: \' + err.message, \'error\');\n    return false;\n  }\n}"
      replacement_content: "  try {\n    await supabase.from(\'reports\').update(updates).eq(\'id\', editingReport.id);\n    await supabase.from(\'audit_log\').insert({ action:\'edit\', admin: currentAdmin?.username, report_id: editingReport.id, payload: updates });\n    \n    const idx = allReports.findIndex(r => r.id === editingReport.id);\n    if (idx > -1) allReports[idx] = { ...allReports[idx], ...updates };\n    window.applyFilters(); renderRecentTable(); renderPhotos();\n    toast(\'Signalement mis \303\240 jour\', \'success\');\n    window.closeEditor();\n  } catch (err) {\n    toast(\'Erreur: \' + err.message, \'error\');\n  } finally {\n    btn.disabled = false; btn.textContent = \'Enregistrer\';\n  }\n}\n\nwindow.toggleFlag = async function toggleFlag() {\n  if (!editingReport) return;\n  const newFlagged = !editingReport.flagged;\n  try {\n    await supabase.from(\'reports\').update({ flagged: newFlagged }).eq(\'id\', editingReport.id);\n    await supabase.from(\'audit_log\').insert({ action: newFlagged ? \'flag\' : \'unflag\', admin: currentAdmin?.username, report_id: editingReport.id });\n    editingReport.flagged = newFlagged;\n    const btn = document.getElementById(\'ep-flag-btn\');\n    btn?.classList.toggle(\'flagged\', newFlagged);\n    btn.textContent = newFlagged ? \'\342\234\205 Valider\' : \'\360\237\232\251 Signaler faux\';\n    const idx = allReports.findIndex(r => r.id === editingReport.id);\n    if (idx > -1) allReports[idx].flagged = newFlagged;\n    renderFlagged(); updateBadges();\n    toast(newFlagged ? \'Marqu\303\251 comme faux signalement\' : \'Signalement valid\303\251\', \'info\');\n  } catch (err) {\n    toast(\'Erreur: \' + err.message, \'error\');\n  }\n}\n\nwindow.deleteReport = async function deleteReport() {\n  if (!editingReport) return;\n  confirm_({\n    icon:\'\360\237\227\221\357\270\217\', title:\'Supprimer ce signalement ?\',\n    body:\'Cette action est irr\303\251versible. Le signalement et sa photo seront supprim\303\251s d\303\251finitivement.\',\n    ok:\'Supprimer\',\n    async onOk() {\n      const id = editingReport.id;\n      const photoUrl = safePhotoUrl(editingReport.photo_url);\n      window.closeEditor();\n      try {\n        if (photoUrl) {\n          const path = photoUrl.split(\'/photos/\').pop();\n          if (path) await supabase.storage.from(\'photos\').remove([path]);\n        }\n        await supabase.from(\'reports\').delete().eq(\'id\', id);\n        await supabase.from(\'audit_log\').insert({ action:\'delete\', admin: currentAdmin?.username, report_id: id });\n        allReports = allReports.filter(r => r.id !== id);\n        window.applyFilters(); renderRecentTable(); renderPhotos(); renderFlagged(); renderArchived(); updateBadges();\n        toast(\'Signalement supprim\303\251\', \'success\');\n      } catch (err) {\n        toast(\'Erreur: \' + err.message, \'error\');\n      }\n    }\n  });\n}\n\n// \342\224\200\342\224\200 QUICK ROW ACTIONS \342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\nasync function quickAction(id, updates, action) {\n  try {\n    await supabase.from(\'reports\').update(updates).eq(\'id\', id);\n    await supabase.from(\'audit_log\').insert({ action: action, admin: currentAdmin?.username, report_id: id, payload: JSON.stringify(updates) });\n    const idx = allReports.findIndex(r => r.id === id);\n    if (idx > -1) allReports[idx] = { ...allReports[idx], ...updates };\n    window.applyFilters(); renderRecentTable(); renderPhotos(); renderFlagged(); renderArchived(); updateBadges();\n    return true;\n  } catch (err) {\n    toast(\'Erreur: \' + err.message, \'error\');\n    return false;\n  }\n}"
