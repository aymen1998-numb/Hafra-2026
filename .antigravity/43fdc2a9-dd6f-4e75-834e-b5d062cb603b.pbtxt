        }
        lines {
          text: "        stateToPlaces[state].add(place);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        knownPlaces.add(place);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        changed = true;"
