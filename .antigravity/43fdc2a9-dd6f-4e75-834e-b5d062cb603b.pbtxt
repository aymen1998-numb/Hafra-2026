          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const d = Date.now() - timeMs;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const m = Math.floor(d/60000), h = Math.floor(d/3600000), days = Math.floor(d/86400000);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  if (m < 2) return \'\303\240 l\\\'instant\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
