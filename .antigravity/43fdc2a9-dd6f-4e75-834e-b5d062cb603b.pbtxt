        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const btn = document.getElementById(\'submit-btn\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const spin = document.getElementById(\'submit-spin\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
